<?xml version="1.0" encoding="utf-8" ?>
<odoo>>
  <record id="ina_lat_res_celdas_equipos_tree" model="ir.ui.view">
  <field name="name">ina.lat.res.celdas.equipos.tree</field>
  <field name="model">res.celdas.equipos</field>
  <field name="arch" type="xml">
    <list string="Celdas Equipos" default_order="id DESC">
      <field name="premo_num" widget="char" optional="show" />
      <field name="funcion" optional="show" />
      <field name="fase" optional="show" />
      <field name="num_serie" optional="show" />
      <field name="product_id" optional="show" />
      <field name="nota" optional="show" />
    </list>
  </field>
</record>

  <record model="ir.ui.view" id="ina_lat_res_celdas_equipos_search_view">
  <field name="name">ina.lat.res.celdas.equipos.search.view</field>
  <field name="model">res.celdas.equipos</field>
  <field name="arch" type="xml">
    <search string="Filtros Ensayos celdas Equipos">
      <field name="product_id" />
      <field name="num_serie" />
      <field name="premo_num" />
      <field name="funcion" />
      <separator />
      <group expand="0" string="Group By">
        <filter
          string="Producto"
          name="group-producto"
          domain="[]"
          context="{'group_by':'product_id'}"
        />
        <filter
          string="Funcion"
          name="group-funcion"
          domain="[]"
          context="{'group_by':'funcion'}"
        />
      </group>
    </search>
  </field>
</record>

  <record id="action_ina_res_celdas_equipos" model="ir.actions.act_window">
  <field name="name">Celdas Otros Equipos</field>
  <field name="type">ir.actions.act_window</field>
  <field name="res_model">res.celdas.equipos</field>
  <field name="view_mode">list</field>
  <field name="view_id" ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_equipos_tree" />
  <field
    name="search_view_id"
    ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_equipos_search_view"
  />
</record>


  <menuitem
  name="Celdas Equipos"
  action="action_ina_res_celdas_equipos"
  id="ina_menu_res_celdas_equipos"
  parent="menu_lat_celdas"
  sequence="70"
/>
</odoo>
