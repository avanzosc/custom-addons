<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_lat_res_celdas_secciona_tree" model="ir.ui.view">
    <field name="name">ina.lat.res.celdas.secciona.tree</field>
    <field name="model">res.celdas.seccionadores</field>
    <field name="arch" type="xml">
      <list string="Celdas Seccionadores" default_order="id DESC">
        <field name="premo_num" widget="char" optional="show" />
        <field name="posicion" optional="show" />
        <field name="seccionador" optional="show" />
        <field name="descripcion" optional="show" />
        <field name="num_maniobras" optional="show" />
        <field name="resis_nomi" optional="show" />
        <field name="tol_resis" optional="show" />
        <field name="res_r_med" optional="show" />
        <field name="res_s_med" optional="show" />
        <field name="res_t_med" optional="show" />
        <field name="vel_nom_aper" optional="show" />
        <field name="tol_vel_aper" optional="show" />
        <field name="vel_aper_med" optional="show" />
        <field name="vel_nom_cier" optional="show" />
        <field name="tol_vel_cier" optional="show" />
        <field name="vel_cier_med" optional="show" />
        <field name="tiempo_fases_max" optional="show" />
        <field name="tiempo_aper_med" optional="show" />
        <field name="tiempo_cierre_med" optional="show" />
        <field name="fecha_res_vel" optional="show" />
        <field name="ens_res_vel" optional="show" />
        <field name="ensayo_resis" optional="show" />
        <field name="ensayo_veloc" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_lat_res_celdas_secciona_search_view">
    <field name="name">ina.lat.res.celdas.secciona.search.view</field>
    <field name="model">res.celdas.seccionadores</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos celdas">
        <field name="seccionador" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="seccionador"
            name="group-seccinador"
            domain="[]"
            context="{'group_by':'seccionador'}"
          />
          <filter
            string="Fecha"
            name="group-fecha"
            domain="[]"
            context="{'group_by':'fecha_res_vel'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_res_celdas_secciona" model="ir.actions.act_window">
    <field name="name">Celdas Seccionadores</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.celdas.seccionadores</field>
    <field name="view_mode">list</field>
    <field
      name="view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_secciona_tree"
    />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_secciona_search_view"
    />
  </record>

  <menuitem
    name="Celdas Seccionadores"
    action="action_ina_res_celdas_secciona"
    id="ina_menu_res_celdas_secciona"
    parent="menu_lat_celdas"
    sequence="20"
  />
</odoo>
