<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_lat_res_trafos_relacion_tree" model="ir.ui.view">
    <field name="name">ina.lat.res.trafos.relacion.tree</field>
    <field name="model">res.trafos.relacion</field>
    <field name="arch" type="xml">
      <list string="Trafos Relacion" default_order="id DESC">
        <field name="trafo_id" widget="char" column_invisible="1" />
        <field name="num_serie" optional="show" />
        <field name="at_bt" optional="show" />
        <field name="posicion" optional="show" />
        <field name="conexion" optional="show" />
        <field name="val_teori" optional="show" />
        <field name="fase_u" optional="show" />
        <field name="fase_v" optional="show" />
        <field name="fase_w" optional="show" />
        <field name="simbol_acopla" optional="show" />
        <field name="fecha" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_lat_res_trafos_relacion_search_view">
    <field name="name">ina.lat.res.trafos.relacion.search.view</field>
    <field name="model">res.trafos.relacion</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos trafos">
        <field name="num_serie" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Fecha"
            name="group-fecha"
            domain="[]"
            context="{'group_by':'fecha'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_res_trafos_relacion" model="ir.actions.act_window">
    <field name="name">Trafos Relacion</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.trafos.relacion</field>
    <field name="view_mode">list</field>
    <field
      name="view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_trafos_relacion_tree"
    />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_trafos_relacion_search_view"
    />
  </record>

  <menuitem
    id="menu_lat_trafos"
    name="Ensayos de Trafos"
    parent="ina_mp_lat_res_ensayos.ina_qc_lat"
    sequence="20"
  />

  <menuitem
    name="Trafos Relacion"
    action="action_ina_res_trafos_relacion"
    id="ina_menu_res_trafos_relacion"
    parent="menu_lat_trafos"
    sequence="20"
  />
</odoo>
