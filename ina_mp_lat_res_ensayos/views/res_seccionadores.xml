<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_lat_res_seccionadores_tree" model="ir.ui.view">
    <field name="name">ina.lat.res.seccionadores.tree</field>
    <field name="model">res.seccionadores</field>
    <field name="arch" type="xml">
      <list
        string="Resultados Seccionadores"
        editable="top"
        default_order="fecha_ensayo DESC"
      >
        <field name="name" optional="show" />
        <field name="num_serie" optional="show" />
        <field name="production_id" optional="show" />
        <field name="product_id" optional="show" />
        <field name="product_name" optional="show" />
        <field name="fecha_ensayo" optional="show" />
        <field name="ensayo_calidad" optional="show" />
        <field name="unipolar" optional="show" />
        <field name="res_nominal" optional="show" />
        <field name="tol_resis" optional="show" />
        <field name="res_r_medida" optional="show" />
        <field name="res_s_medida" optional="show" />
        <field name="res_t_medida" optional="show" />
        <field name="ensayo_finalizado" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_lat_res_seccionadores_search_view">
    <field name="name">ina.lat.res.seccionadores.search.view</field>
    <field name="model">res.seccionadores</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos seccionadores">
        <field name="num_serie" />
        <field name="product_id" />
        <field name="production_id" />
        <field name="ensayo_calidad" />
        <field name="product_name" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Producto"
            name="group-producto"
            domain="[]"
            context="{'group_by':'product_id'}"
          />
          <filter
            string="Fecha Ensayo"
            name="group-fecha-ensayo"
            domain="[]"
            context="{'group_by':'fecha_ensayo'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_res_seccionadores" model="ir.actions.act_window">
    <field name="name">Resultado Seccionadores</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.seccionadores</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="ina_mp_lat_res_ensayos.ina_lat_res_seccionadores_tree" />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_seccionadores_search_view"
    />
  </record>

  <!--   LOS GENERICOS, PRINCIPAL  -->
  <menuitem
    id="menu_lat_ensayos"
    name="Ensayos Configuracion"
    parent="ina_mp_lat_res_ensayos.ina_qc_lat"
    sequence="900"
  />

  <menuitem
    name="Seccionadores"
    action="action_ina_res_seccionadores"
    id="ina_menu_res_seccionadores"
    parent="menu_lat_res_ensayos"
    sequence="300"
  />
</odoo>
