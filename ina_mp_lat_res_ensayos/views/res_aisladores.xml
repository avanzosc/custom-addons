<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_lat_res_aisladores_tree" model="ir.ui.view">
    <field name="name">ina.lat.res.aisladores.tree</field>
    <field name="model">res.aisladores</field>
    <field name="arch" type="xml">
      <list
        string="Resultados Aisladores"
        editable="top"
        default_order="fecha_ensayo desc"
      >
        <field name="name" widget="char" optional="show" />
        <field name="num_serie" widget="char" optional="show" />
        <field name="production_id" optional="show" />
        <field name="product_id" optional="show" />
        <field name="tension" optional="show" />
        <field name="rechazado" optional="show" />
        <field name="fecha_ensayo" optional="show" />
        <field name="notas" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_lat_res_aisladores_search_view">
    <field name="name">ina.lat.res.aisladores.search.view</field>
    <field name="model">res.aisladores</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos Aisladores">
        <field name="num_serie" />
        <field name="product_id" />
        <field name="production_id" />
        <field name="rechazado" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Producto"
            name="group-producto"
            domain="[]"
            context="{'group_by':'product_id'}"
          />
          <filter
            string="Fecha Ensayo"
            name="group-fecha-ensayo"
            domain="[]"
            context="{'group_by':'fecha_ensayo'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_res_aisladores" model="ir.actions.act_window">
    <field name="name">Resultado Aisladores</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.aisladores</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="ina_mp_lat_res_ensayos.ina_lat_res_aisladores_tree" />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_aisladores_search_view"
    />
  </record>

  <!-- MENU PRINCIPAL -->
  <menuitem
    id="ina_qc_lat"
    name="Lat"
    sequence="45"
    groups="ina_mc_permisos.group_inael_lat_user,ina_mc_permisos.group_inael_calidad_respon,ina_mc_permisos.group_inael_fabrica_respon"
  />

  <menuitem
    id="menu_lat_res_ensayos"
    name="Ensayos de Productos"
    parent="ina_mp_lat_res_ensayos.ina_qc_lat"
    sequence="30"
  />

  <menuitem
    name="Aisladores"
    action="action_ina_res_aisladores"
    id="ina_menu_res_aisladores"
    parent="menu_lat_res_ensayos"
    sequence="450"
  />
</odoo>
