<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_lat_res_pararrayos_tree" model="ir.ui.view">
    <field name="name">ina.lat.res.pararrayos.tree</field>
    <field name="model">res.pararrayos</field>
    <field name="arch" type="xml">
      <list
        string="Resultados Pararrayos"
        editable="top"
        default_order="fecha_ensayo DESC"
      >
        <field name="name" widget="char" optional="show" />
        <field name="num_serie" widget="char" optional="show" />
        <field name="production_id" optional="show" />
        <field name="product_id" optional="show" />
        <field name="poten_ensa" optional="show" />
        <field name="corri_ensa" optional="show" />
        <field name="tensi_refer" optional="show" />
        <field name="riv_ensa" optional="show" />
        <field name="coro_ensa" optional="show" />
        <field name="fecha_ensayo" optional="show" />
        <field name="rechazado" optional="show" />
        <field name="orden_conjunto" optional="show" />
        <field name="num_serie_conj" optional="show" />
        <field name="nota" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_lat_res_pararrayos_search_view">
    <field name="name">ina.lat.res.pararrayos.search.view</field>
    <field name="model">res.pararrayos</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos pararrayos">
        <field name="num_serie" />
        <field name="product_id" />
        <field name="orden_conjunto" />
        <field name="num_serie_conj" />
        <field name="production_id" />
        <field name="rechazado" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Producto"
            name="group-producto"
            domain="[]"
            context="{'group_by':'product_id'}"
          />
          <filter
            string="Fecha Ensayo"
            name="group-fecha-ensayo"
            domain="[]"
            context="{'group_by':'fecha_ensayo'}"
          />
          <filter
            string="Orden Conjunto"
            name="group-orden-conjunto"
            domain="[]"
            context="{'group_by':'orden_conjunto'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_res_pararrayos" model="ir.actions.act_window">
    <field name="name">Resultado Pararrayos</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.pararrayos</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="ina_mp_lat_res_ensayos.ina_lat_res_pararrayos_tree" />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_pararrayos_search_view"
    />
  </record>

  <menuitem
    name="Pararrayos"
    action="action_ina_res_pararrayos"
    id="ina_menu_res_pararrayos"
    parent="menu_lat_res_ensayos"
    sequence="400"
  />
</odoo>
