<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_lat_res_seccionalizadores_tree" model="ir.ui.view">
    <field name="name">ina.lat.res.seccionalizadores.tree</field>
    <field name="model">res.seccionalizadores</field>
    <field name="arch" type="xml">
      <list
        string="Resultados seccionalizadores"
        editable="top"
        default_order="fecha_ensayo DESC"
      >
        <field name="name" widget="char" optional="show" />
        <field name="num_serie" widget="char" optional="show" />
        <field name="production_id" optional="show" />
        <field name="product_id" optional="show" />
        <field name="fecha_ensayo" optional="show" />
        <field name="version" optional="show" />
        <field name="canal" optional="show" />
        <field name="num_faltas" optional="show" />
        <field name="corri_faltas" optional="show" />
        <field name="tiempo_reset" optional="show" />
        <field name="retardo" optional="show" />
        <field name="frecuencia" optional="show" />
        <field name="corriente_ok" optional="show" />
        <field name="disparo_ok" optional="show" />
        <field name="notas" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_lat_res_seccionalizadores_search_view">
    <field name="name">ina.lat.res.seccionalizadores.search.view</field>
    <field name="model">res.seccionalizadores</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos seccionalizadores">
        <field name="num_serie" />
        <field name="product_id" />
        <field name="production_id" />
        <field name="version" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Producto"
            name="group-producto"
            domain="[]"
            context="{'group_by':'product_id'}"
          />
          <filter
            string="Fecha Ensayo"
            name="group-fecha-ensayo"
            domain="[]"
            context="{'group_by':'fecha_ensayo'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_res_seccionalizadores" model="ir.actions.act_window">
    <field name="name">Resultado seccionalizadores</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.seccionalizadores</field>
    <field name="view_mode">list</field>
    <field
      name="view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_seccionalizadores_tree"
    />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_seccionalizadores_search_view"
    />
  </record>

  <menuitem
    name="Seccionalizadores"
    action="action_ina_res_seccionalizadores"
    id="ina_menu_res_seccionalizadores"
    parent="menu_lat_res_ensayos"
    sequence="470"
  />
</odoo>
