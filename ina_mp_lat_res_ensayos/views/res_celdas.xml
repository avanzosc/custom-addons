  </record>

  <!--     Action          -->
  <record id="action_ina_res_celdas" model="ir.actions.act_window">
    <field name="name">Resultado Celdas</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.celdas</field>
    <field name="view_mode">list,form</field>
    <field name="view_id" ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_tree" />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_search_view"
    />
  </record>

  <record id="action_ina_res_celdas_llenado" model="ir.actions.act_window">
    <field name="name">Celdas Llenado</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.celdas</field>
    <field name="view_mode">list</field>
    <field
      name="view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_llenado_tree"
    />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_llenado_search_view"
    />
  </record>

  <record id="action_ina_res_celdas_dielectrico" model="ir.actions.act_window">
    <field name="name">Celdas Dielectrico</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.celdas</field>
    <field name="view_mode">list</field>
    <field
      name="view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_dielectrico_tree"
    />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_dielectrico_search_view"
    />
  </record>

  <record id="action_ina_res_celdas_embolsa" model="ir.actions.act_window">
    <field name="name">Celdas Embolsamiento</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.celdas</field>
    <field name="view_mode">list</field>
    <field
      name="view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_embolsa_tree"
    />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_celdas_embolsa_search_view"
    />
  </record>

  <menuitem
    name="Celdas"
    action="action_ina_res_celdas"
    id="ina_menu_res_celdas"
    parent="menu_lat_celdas"
    sequence="10"
  />

  <menuitem
    name="Celdas Llenado"
    action="action_ina_res_celdas_llenado"
    id="ina_menu_res_celdas_llenado"
    parent="menu_lat_celdas"
    sequence="30"
  />
  <menuitem
    name="Celdas Dielectrico"
    action="action_ina_res_celdas_dielectrico"
    id="ina_menu_res_celdas_dielectrico"
    parent="menu_lat_celdas"
    sequence="40"
  />
  <menuitem
    name="Celdas Embolsamiento"
    action="action_ina_res_celdas_embolsa"
    id="ina_menu_res_celdas_embolsa"
    parent="menu_lat_celdas"
    sequence="50"
  />
</odoo>
