<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_lat_res_trafos_resultados_tree" model="ir.ui.view">
    <field name="name">ina.lat.res.trafos.resultados.tree</field>
    <field name="model">res.trafos.resultados</field>
    <field name="arch" type="xml">
      <list string="Trafos Resultados" default_order="id DESC">
        <field name="trafo_id" widget="char" column_invisible="1" />
        <field name="num_serie" optional="show" />
        <field name="relacion" optional="show" />
        <field name="ensayo" optional="show" />
        <field name="garantia" optional="show" />
        <field name="tolerancia" optional="show" />
        <field name="resultado" optional="show" />
        <field name="fecha" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_lat_res_trafos_resultados_search_view">
    <field name="name">ina.lat.res.trafos.resultados.search.view</field>
    <field name="model">res.trafos.resultados</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos trafos">
        <field name="num_serie" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Fecha"
            name="group-fecha"
            domain="[]"
            context="{'group_by':'fecha'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_res_trafos_resultados" model="ir.actions.act_window">
    <field name="name">Trafos Resultados</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.trafos.resultados</field>
    <field name="view_mode">list</field>
    <field
      name="view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_trafos_resultados_tree"
    />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_trafos_resultados_search_view"
    />
  </record>

  <menuitem
    name="Trafos Resultados"
    action="action_ina_res_trafos_resultados"
    id="ina_menu_res_trafos_resultados"
    parent="menu_lat_trafos"
    sequence="60"
  />
</odoo>
