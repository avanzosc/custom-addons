<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_lat_res_trafos_dielectrico_tree" model="ir.ui.view">
    <field name="name">ina.lat.res.trafos.dielectrico.tree</field>
    <field name="model">res.trafos.dielectrico</field>
    <field name="arch" type="xml">
      <list string="Trafos Dielectrico" default_order="id DESC">
        <field name="trafo_id" widget="char" column_invisible="1" />
        <field name="num_serie" optional="show" />
        <field name="tipo" optional="show" />
        <field name="terminales" optional="show" />
        <field name="tension" optional="show" />
        <field name="tiempo" optional="show" />
        <field name="frecuencia" optional="show" />
        <field name="fecha" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_lat_res_trafos_dielectrico_search_view">
    <field name="name">ina.lat.res.trafos.dielectrico.search.view</field>
    <field name="model">res.trafos.dielectrico</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos trafos">
        <field name="num_serie" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Fecha"
            name="group-fecha"
            domain="[]"
            context="{'group_by':'fecha'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_res_trafos_dielectrico" model="ir.actions.act_window">
    <field name="name">Trafos Dielectrico</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">res.trafos.dielectrico</field>
    <field name="view_mode">list</field>
    <field
      name="view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_trafos_dielectrico_tree"
    />
    <field
      name="search_view_id"
      ref="ina_mp_lat_res_ensayos.ina_lat_res_trafos_dielectrico_search_view"
    />
  </record>

  <menuitem
    name="Trafos Dielectrico"
    action="action_ina_res_trafos_dielectrico"
    id="ina_menu_res_trafos_dielectrico"
    parent="menu_lat_trafos"
    sequence="50"
  />
</odoo>
