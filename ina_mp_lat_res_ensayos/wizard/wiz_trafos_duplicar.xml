<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="wiz_trafos_duplicar" model="ir.ui.view">
    <field name="name">wiz_trafos_duplicar</field>
    <field name="model">wiz.trafos.duplicar</field>
    <field name="arch" type="xml">
      <form string="Wizard para Duplicar Ensayos">
        <group>
          <field name="num_serie" string="Nuevo numero de serie" required="1" />
        </group>
        <footer>
          <button
            icon="gtk-execute"
            name="action_duplica_trafo"
            string="Duplicar Trafo"
            type="object"
            class="oe_highlight"
          />
          <button
            icon="gtk-cancel"
            string="Cancelar"
            class="oe_link"
            special="cancel"
          />
        </footer>
      </form>
    </field>
  </record>

  <record id="action_wiz_trafos_duplicar" model="ir.actions.act_window">
    <field name="name">Duplicar Trafo</field>
    <field name="res_model">wiz.trafos.duplicar</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field name="binding_model_id" ref="ina_mp_lat_res_ensayos.model_res_trafos" />
    <field name="binding_view_types">form</field>
  </record>
</odoo>
