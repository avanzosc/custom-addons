<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="product_catalog_web_view_form" model="ir.ui.view">
    <field name="name">product.catalog.web.view.form</field>
    <field name="model">product.catalog.web</field>
    <field name="arch" type="xml">
      <form string="Product Catalog web">
        <sheet>
          <div class="oe_button_box" name="button_box" />
          <field name="logo" widget="image" class="oe_avatar" />
          <div class="oe_title">
            <label for="name" string="Catalog name" />
            <h1>
              <field name="name" placeholder="e.g. PRE-BOOK" />
            </h1>
          </div>
          <group>
            <group>
              <field name="pricelist_ids" widget="many2many_tags" />
              <field name="commitment_date" />
              <field name="inventory_availability" />
              <field name="active" />
            </group>
            <group>
              <field name="date_start" />
              <field name="date_end" />
              <field name="company_id" groups="base.group_multi_company" />
              <field name="warehouse_id" />
              <field name="visible_slider" />
            </group>
          </group>
          <notebook>
            <page string="Products" name="products">
              <field name="product_ids">
                <list>
                  <field name="website_sequence" />
                  <field name="default_code" />
                  <field name="barcode" />
                  <field name="name" />
                  <field name="product_brand_id" />
                  <field name="list_price" />
                  <field name="categ_id" />
                  <field name="qty_available" />
                  <field name="is_published" widget="boolean_toggle" />
                  <field name="catalog_ids" widget="many2many_tags" />
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="product_catalog_web_view_tree" model="ir.ui.view">
    <field name="name">product.catalog.web.view.list</field>
    <field name="model">product.catalog.web</field>
    <field name="arch" type="xml">
      <list>
        <field name="name" />
        <field name="date_start" />
        <field name="date_end" />
        <field name="company_id" groups="base.group_multi_company" />
        <field name="visible_slider" />
        <field name="active" />
      </list>
    </field>
  </record>

  <record id="product_catalog_web_action" model="ir.actions.act_window">
    <field name="name">Web catalogs</field>
    <field name="res_model">product.catalog.web</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    id="product_catalog_web_menu_act"
    name="Product Catalog web"
    parent="sale.product_menu_catalog"
    action="product_catalog_web_action"
    sequence="7"
  />
</odoo>
