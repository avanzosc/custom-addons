<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="wiz_fichar_orden_view" model="ir.ui.view">
    <field name="name">wiz.fichar.orden.form</field>
    <field name="model">wiz.fichar.orden</field>
    <field name="arch" type="xml">
      <form string="Fichar Orden">
        <group>
          <field name="tipo_fichar" readonly="1" />
        </group>
        <group>
          <field name="fichar_id" invisible="1" />
          <field name="employee_id" readonly="1" widget="many2one" />
          <field
            name="puesto_id"
            required="tipo_fichar != 'comunicar'"
            readonly="tipo_fichar == 'comunicar'"
            options="{'no_create': True}"
          />
          <field name="centro_puesto" invisible="1" />
          <field
            name="tipo"
            required="1"
            readonly="tipo_fichar == 'comunicar'"
            widget="radio"
          />
          <field name="production_id" invisible="tipo != 'of'" readonly="1" />
          <field
            name="workorder_id"
            required="tipo == 'of'"
            invisible="tipo != 'of'"
            readonly="tipo_fichar == 'comunicar'"
            options="{'no_create_edit': True}"
            domain="[('workcenter_id', '=', centro_puesto), ('state', 'in', ('pending', 'ready', 'progress'))]"
          />
          <field
            name="repara_id"
            required="tipo == 'repara'"
            invisible="tipo != 'repara'"
            readonly="tipo_fichar == 'comunicar'"
            options="{'no_create_edit': True}"
          />
          <field
            name="laser_id"
            required="tipo == 'laser'"
            invisible="tipo != 'laser'"
            readonly="tipo_fichar == 'comunicar'"
            options="{'no_create_edit': True}"
          />
          <field
            name="improductivo"
            required="tipo == 'impro'"
            invisible="tipo != 'impro'"
            readonly="tipo_fichar == 'comunicar'"
            options="{'no_create_edit': True}"
          />
          <field name="datos_orden" invisible="tipo != 'of'" readonly="1" />
          <field name="datos_laser" invisible="tipo != 'laser'" readonly="1" />
          <field name="cantidad" invisible="tipo_fichar != 'comunicar'" />
          <field
            name="cantidad_rechazada"
            invisible="tipo != 'of' or tipo_fichar != 'comunicar'"
          />
          <field
            name="refer_faltan"
            invisible="tipo != 'of' or tipo_fichar != 'comunicar'"
          />
          <div invisible="tipo_fichar != 'no'" class="text-primary fw-bold">
                        No puedes comunicar
                    </div>
        </group>
        <footer>
          <button
            name="crear_orden"
            type="object"
            string="Crear Orden"
            class="btn-primary"
            invisible="tipo_fichar in ('comunicar', 'no')"
          />
          <button
            name="comunicar_orden"
            type="object"
            string="Comunicar Orden"
            class="btn-primary"
            invisible="tipo_fichar in ('nueva', 'no')"
          />
          <button special="cancel" string="Cancelar" class="btn-default" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
