<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_hr_employee_fichar_field" model="ir.ui.view">
    <field name="name">ina.hr.employee.fichar.field</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form" />
    <field name="arch" type="xml">
      <field name="job_id" position="after">
        <field name="fichar" />
      </field>
    </field>
  </record>

  <record id="ina_hr_employee_fichar_tree_field" model="ir.ui.view">
    <field name="name">ina.hr.employee.fichar.tree.field</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_tree" />
    <field name="arch" type="xml">
      <field name="name" position="after">
        <field name="fichar" />
      </field>
    </field>
  </record>
</odoo>
