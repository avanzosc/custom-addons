<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="ina_stock_move_fichar_view" model="ir.ui.view">
    <field name="name">ina.hr_stock_move_fichar</field>
    <field name="model">stock.move</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <list string="Material a Consumir" edit="false" create="false" delete="false">
        <field name="workorder_id" />
        <field name="product_id" />
        <field name="product_uom" string="Unidad" />
        <field name="location_id" />
        <field name="state" />
        <field name="forecast_availability" string="Cantidad Prevista" />
        <field
          name="product_uom_qty"
          string="A Consumir"
          decoration-success="picked or forecast_availability &gt;= product_uom_qty"
          decoration-danger="not picked and forecast_availability &lt; product_uom_qty"
        />
        <field name="quantity" />
        <field name="picked" string="Consumido" />
        <button
          type="object"
          name="action_ver_stock"
          string="Ver Stock/Ubicacion"
          icon="fa-eye"
        />
      </list>
    </field>
  </record>

  <record id="ina_hr_stock_move_fichar_search" model="ir.ui.view">
    <field name="name">ina.hr_stock.move.fichar.search</field>
    <field name="model">stock.move</field>
    <field name="priority">100</field>
    <field name="arch" type="xml">
      <search string="Filtros Stock move Fichar">
        <field name="workorder_id" />
        <field name="product_id" />
      </search>
    </field>
  </record>

  <record id="action_hr_stock_move_fichar" model="ir.actions.act_window">
    <field name="name">Material a Consumir</field>
    <field name="res_model">stock.move</field>
    <field name="view_mode">list</field>
    <field name="search_view_id" ref="ina_hr_stock_move_fichar_search" />
    <field name="view_id" ref="ina_stock_move_fichar_view" />
  </record>
</odoo>
