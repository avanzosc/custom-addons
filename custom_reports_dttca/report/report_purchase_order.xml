<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_purchaseorder_document_alq">
        <t t-call="custom_reports_dttca.external_layout_alq">
            <div class="header" style="font-size: 12px;">
                <div class="row mt16 mb16">
                    <div class="col-6">
                        <div style="font-size: 18px;font-weight: bold;padding-top:10mm">
                            <span style="font-size: 18px">PURCHASE ORDER</span>
                        </div>
                        <div>
                            <span style="font-size: 18px;position: absolute;">
                                <span style="font-weight: bold;">Nº:</span>
                                <span t-field="o.name"/>
                            </span>
                            <span style="font-size: 18px;left:45mm;position: absolute;">
                                <span style="font-weight: bold;">Date:</span>
                                <span t-field="o.date_order"
                                      t-options="{'widget': 'date', 'format':'dd/MM/yy'}"/>
                            </span>
                        </div>
                    </div>
                    <div class="col-6 text-right">
                        <img src="/custom_reports_dttca/static/src/img/logo_left.png"
                             style="height: 100px;"/>
                    </div>
                </div>
                <div class="row mt16 mb16">
                    <div class="col-6">
                        <!--<t t-if="'Extracom' in o.partner_id.property_account_position_id.name">-->
                        <div style="color: #7F7F7F;font-size: 9px;font-weight: bold;">
                            Seller
                        </div>
                        <div name="invoice_address">
                            <div style="font-weight: bold;">
                                <span t-field="o.partner_id.name"/>
                            </div>
                            <div>
                                <span t-field="o.partner_id.street"/>
                            </div>
                            <div>
                                <span t-field="o.partner_id.street2"/>
                            </div>
                            <div>
                                <span t-field="o.partner_id.zip"/>
                                <span t-field="o.partner_id.city"/>
                                (<t t-esc="o.partner_id.country_id.name"/>)
                            </div>
                            <div>
                                VAT:
                                <span t-field="o.partner_id.vat"/>
                            </div>
                        </div>
                        <div style="font-size: 9px;margin-top:2mm;">
                            <div t-if="o.partner_id.phone">
                                <i class="fa fa-phone"/>
                                <span t-field="o.partner_id.phone"/>
                            </div>
                            <div t-if="o.partner_id.email">
                                <i class="fa fa-at"/>
                                <span t-field="o.partner_id.email"/>
                            </div>
                        </div>
                        <!--</t>-->
                    </div>
                    <div class="col-6">
                        <div class="col-12">
                            <div style="color: #7F7F7F;font-size: 9px;font-weight: bold;">
                                Invoiced
                            </div>
                            <div style="color: #8B857F;">
                                <div style="font-weight: bold;">
                                    <span t-field="o.company_id.partner_id.name"/>
                                </div>
                                <div>
                                    <span t-field="o.company_id.street"/>
                                </div>
                                <div>
                                    <span t-field="o.company_id.street2"/>
                                </div>
                                <div>
                                    <span t-field="o.company_id.zip"/>
                                    <span t-field="o.company_id.city"/>
                                    (<t t-esc="o.company_id.country_id.name"/>)
                                </div>
                                <div>
                                    VAT:
                                    <span t-field="o.company_id.vat"/>
                                </div>
                            </div>
                            <div style="color: #8B857F;font-size: 9px;margin-top:2mm;">
                                <div>
                                    <i class="fa fa-phone"/>
                                    <span t-field="o.company_id.phone"/>
                                </div>
                                <div>
                                    <i class="fa fa-at"/>
                                    <span t-field="o.company_id.email"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12" style="margin-top:4mm">
                            <div style="color: #7F7F7F;font-size: 9px;font-weight: bold;">
                                Delivery
                            </div>
                            <t t-if="o.dest_address_id and o.company_id.partner_id!=o.dest_address_id">
                                <div>
                                    <div style="font-weight: bold;">
                                        <span t-field="o.dest_address_id.name"/>
                                    </div>
                                    <div>
                                        <span t-field="o.dest_address_id.street"/>
                                    </div>
                                    <div>
                                        <span t-field="o.dest_address_id.street2"/>
                                    </div>
                                    <div>
                                        <span t-field="o.dest_address_id.zip"/>
                                        <span t-field="o.dest_address_id.city"/>
                                        (<t t-esc="o.dest_address_id.country_id.name"/>)
                                    </div>
                                </div>
                                <div style="font-size: 10px;margin-top:2mm;">
                                    <div t-if="o.dest_address_id.phone">
                                        <i class="fa fa-phone"/>
                                        <span t-field="o.dest_address_id.phone"/>
                                    </div>
                                    <div t-if="o.dest_address_id.email">
                                        <i class="fa fa-at"/>
                                        <span t-field="o.dest_address_id.email"/>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div>
                                    SAME AS INVOICED
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:3mm">
                    <div class="col-12">
                        <span t-if="o.partner_ref">
                            <span style="font-weight: bold;">
                                Partner Ref.:
                            </span>
                            <span t-field="o.partner_ref"/>
                        </span>
                    </div>
                </div>
            </div>
            <div class="page" style="font-size: 11px !important;">
                <div class="oe_structure"/>
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th><strong>Description</strong></th>
                            <th class="text-center"><strong>Date Req.</strong></th>
                            <th class="text-right"><strong>Qty</strong></th>
                            <th class="text-right"><strong>Unit Price</strong></th>
                            <th><strong>Taxes</strong></th>
                            <th class="text-right"><strong>Amount</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.order_line" t-as="line">
                            <td>
                                <span t-field="line.name"/>
                            </td>
                            <td class="text-center">
                                <span t-field="line.date_planned"
                                      t-options="{'widget': 'date'}"/>
                            </td>
                            <td style="text-align:right !important;">
                                <span t-field="line.product_qty"/>
                                <span t-field="line.product_uom.name"/>
                            </td>
                            <td style="text-align:right !important;">
                                <span t-field="line.price_unit"/>
                            </td>
                            <td style="text-align:right !important;">
                                <span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/>
                            </td>
                            <td style="text-align:right !important;">
                                <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <div id="total" class="row mt16 mb16 justify-content-end" name="total">
                    <div class="col-4 pull-right">
                        <table class="table table-sm">
                            <tr class="border-black">
                                <td><strong>Subtotal</strong></td>
                                <td style="text-align:right !important;">
                                    <span t-field="o.amount_untaxed" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td>Taxes</td>
                                <td style="text-align:right !important;">
                                    <span t-field="o.amount_tax" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Total</strong></td>
                                <td style="text-align:right !important;">
                                    <span t-field="o.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                <p t-field="o.notes"/>
                <div class="oe_structure"/>
            </div>
        </t>
    </template>

    <template t-name="purchase.report_purchaseorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_reports_dttca.report_purchaseorder_document_alq" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
