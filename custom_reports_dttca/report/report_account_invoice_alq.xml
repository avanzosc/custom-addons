<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_alq">
        <t t-call="custom_reports_dttca.external_layout_alq">
            <div class="header" style="font-size: 12px;">
                <div class="row">
                    <div class="col-6">
                        <div style="font-size: 18px;font-weight: bold;padding-top:10mm">
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'posted'">INVOICE</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice</span>
                            <span t-if="o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice</span>
                            <span t-if="o.move_type == 'out_refund'">Credit Note</span>
                            <span t-if="o.move_type == 'in_refund'">Vendor Credit Note</span>
                            <span t-if="o.move_type == 'in_invoice'">Vendor Bill</span>
                        </div>
                        <div>
                            <span style="font-size: 18px;position: absolute;">
                                <span style="font-weight: bold;">Nº:</span>
                                <span t-field="o.name" />
                            </span>
                            <span style="font-size: 18px;left:55mm;position: absolute;">
                                <span style="font-weight: bold;">Date:</span>
                                <span t-field="o.invoice_date" t-options='{"widget": "date"}'/>
                            </span>
                        </div>
                        <!--
                        <div>
                            <span style="font-size: 14px;">
                                <span style="font-weight: bold;">
                                    Customer Order:
                                </span>
                                <span/>
                            </span>
                            <span style="font-size: 14px;left:85mm;position: absolute;">
                                <span style="font-weight: bold;">
                                    Origin:
                                </span>
                                <span t-field="o.origin"/>
                            </span>
                        </div>
                        -->
                    </div>
                    <div class="col-6 text-right">
                        <img t-if="o.company_id.logo" 
                            t-att-src="image_data_uri(o.company_id.logo)" 
                            style="max-height: 100px; width: auto;" 
                            alt="Logo"/>
                            
                        <div t-if="not o.company_id.logo" style="font-size: 20px; font-weight: bold;">
                            <span t-field="o.company_id.name"/>
                        </div>
                    </div>
                </div>

                <div class="row mb32 mt32" style="margin-top:5mm;">
                    <div class="col-6">
                        <!--<t t-if="'Extracom' in o.partner_id.property_account_position_id.name">-->
                        <div style="color: #7F7F7F;font-size: 10px;font-weight: bold;">
                            Seller / Shipper
                        </div>
                        <div style="color: #8B857F;">
                            <div style="font-weight: bold;">
                                <span t-field="o.company_id.partner_id.name"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.street"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.street2"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.zip"/>
                                <span t-field="o.company_id.city"/>
                                (<t t-esc="o.company_id.country_id.name"/>)
                            </div>
                            <div>
                                VAT:
                                <span t-field="o.company_id.vat"/>
                            </div>
                        </div>
                        <div style="color: #8B857F;font-size: 10px;margin-top:2mm;">
                            <div>
                                <i class="fa fa-phone"/>
                                <span t-field="o.company_id.phone"/>
                            </div>
                            <div>
                                <i class="fa fa-at"/>
                                <span t-field="o.company_id.email"/>
                            </div>
                        </div>
                        <!--</t>-->

                        <div style="color: #7F7F7F;font-size: 10px;font-weight: bold;margin-top:5mm;">
                            Sales Person:
                        </div>
                        <div style="font-size: 10px;">
                            <div>
                                <span t-field="o.user_id.name"/>
                            </div>
                            <div t-if="o.user_id.mobile">
                                <i class="fa fa-phone"/>
                                <span t-field="o.user_id.mobile"/>
                            </div>
                            <div t-if="o.user_id.email">
                                <i class="fa fa-at"/>
                                <span t-field="o.user_id.email"/>
                            </div>
                        </div>

                    </div>

                    <div class="col-6">
                        <div class="col-12">
                            <div style="color: #7F7F7F;font-size: 10px;font-weight: bold;">
                                Invoiced / Consignee
                            </div>
                            <div name="invoice_address">
                                <div style="font-weight: bold;">
                                    <span t-field="o.partner_id.name"/>
                                </div>
                                <div>
                                    <span t-field="o.partner_id.street"/>
                                </div>
                                <div>
                                    <span t-field="o.partner_id.street2"/>
                                </div>
                                <div>
                                    <span t-field="o.partner_id.zip"/>
                                    <span t-field="o.partner_id.city"/>
                                    (<t t-esc="o.partner_id.country_id.name"/>)
                                </div>
                                <div>
                                    VAT:
                                    <span t-field="o.partner_id.vat"/>
                                </div>
                            </div>
                            <div style="font-size: 10px;margin-top:2mm;">
                                <div t-if="o.partner_id.phone">
                                    <i class="fa fa-phone"/>
                                    <span t-field="o.partner_id.phone"/>
                                </div>
                                <div t-if="o.partner_id.email">
                                    <i class="fa fa-at"/>
                                    <span t-field="o.partner_id.email"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12" style="margin-top:4mm">
                            <div style="color: #7F7F7F;font-size: 10px;font-weight: bold;">
                                Delivery / Notify
                            </div>
                            <t t-if="o.partner_id!=o.partner_shipping_id">
                                <div>
                                    <div style="font-weight: bold;">
                                        <span t-field="o.partner_shipping_id.name"/>
                                    </div>
                                    <div>
                                        <span t-field="o.partner_shipping_id.street"/>
                                    </div>
                                    <div>
                                        <span t-field="o.partner_shipping_id.street2"/>
                                    </div>
                                    <div>
                                        <span t-field="o.partner_shipping_id.zip"/>
                                        <span t-field="o.partner_shipping_id.city"/>
                                        (<t t-esc="o.partner_shipping_id.country_id.name"/>)
                                    </div>
                                    <div>

                                    </div>
                                </div>
                                <div style="font-size: 9px;margin-top:2mm;">
                                    <div t-if="o.partner_shipping_id.phone">
                                        <i class="fa fa-phone"></i>
                                        <span t-field="o.partner_shipping_id.phone"/>
                                    </div>
                                    <div t-if="o.partner_shipping_id.email">
                                        <i class="fa fa-at"></i>
                                        <span t-field="o.partner_shipping_id.email"/>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div>
                                    SAME AS INVOICED
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
            <div class="page" style="font-size: 11px;">

                <!-- Is there a discount on at least one line? -->
                <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>
                <t t-set="group_picking" t-value="INIT"/>

                <!-- Is there a discount on at least one line? -->
                <t t-set="display_discount" t-value="any([l.discount for l in o.invoice_line_ids])"/>

                <table class="table table-sm" name="invoice_line_table">
                    <thead style="border-bottom: 2px solid #ab138a;">
                        <tr>
                            <!--
                            <th></th>
                            -->
                            <th>Description</th>
                            <!--<th class="hidden">Source Document</th>-->
                            <th class="text-right">Quantity</th>
                            <th>Taxes</th>
                            <th class="text-right">
                                <t t-if="res_company.show_recommended_price">
                                    <span>Rec. Price</span>
                                </t>
                            </th>
                            <th class="text-right">U. Price</th>
                            <th t-if="display_discount" class="text-right">Disc.(%)</th>
                            <th class="text-right">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="invoice_tbody">
                        <t t-foreach="o.invoice_line_ids.sorted(key=lambda b: str(b.move_id.invoice_origin))" t-as="l">
                            <t t-if="l.move_id.invoice_origin">
                                <t t-if="l.move_line_ids">
                                    <t t-if="group_picking!=l.move_line_ids[0].picking_id.name">
                                        <tr t-attf-style="page-break-inside: avoid !important;"
                                            style="border-top:1px solid #ab138a;">
                                            <td colspan="7"
                                                style="border-bottom: 2px solid #ab138a; !important;font-style: oblique;">
                                                <b style="margin-left:180px">Picking:</b>
                                                <span t-field="l.move_line_ids[0].picking_id.name"/>
                                                <span style="margin-left:6px" />
                                                <b>Date:</b>
                                                <span t-field="l.move_line_ids[0].picking_id.date"
                                                      t-options='{"widget": "date"}'/>
                                                <span style="margin-left:6px" />
                                                <b t-if="l.move_line_ids[0].picking_id.sale_id.client_order_ref">
                                                    Customer Order:
                                                </b>
                                                <span t-field="l.move_line_ids[0].picking_id.sale_id.client_order_ref"/>
                                                <span style="margin-left:6px" />
                                                <b t-if="l.move_id.invoice_origin">Order Nº:</b>
                                                <span t-field="l.move_id.invoice_origin"/>
                                                <t t-set="group_picking"
                                                   t-value="l.move_line_ids[0].picking_id.name"/>
                                            </td>
                                        </tr>
                                    </t>
                                </t>
                                <tr t-attf-style="page-break-inside: avoid !important;">
                                    <!--
                                    <td class="text-center">
                                        <span t-field="l.product_id.image_small"
                                              t-field-options="{&quot;widget&quot;: &quot;image&quot;, &quot;class&quot;: &quot;img-rounded&quot;}"/>
                                    </td>
                                    -->
                                    <td>
                                        <span t-esc="l.name"/>
                                    </td>
                                    <!--<td class="hidden">
                                        <span t-field="l.origin"/>
                                    </td>-->
                                    <td style="text-align:right !important;">
                                        <span t-esc="l.quantity"/>
                                        <span t-field="l.uom_id" groups="product.group_uom"/>
                                    </td>
                                    <td style="text-align:right !important;">
                                        <span t-esc="', '.join(map(lambda x: (x.name or x.description), l.tax_ids))"/>
                                    </td>
                                    <td style="text-align:right !important;">
                                        <t t-if="res_company.show_recommended_price">
                                            <t t-if="l.product_id">
                                                <span t-field="l.product_id.recommended_price"
                                                      t-field-options='{"widget": "monetary", "display_currency": "o.currency_id"}'/>
                                            </t>
                                        </t>
                                    </td>
                                    <td style="text-align:right !important;">
                                        <span t-esc="l.price_unit"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td t-if="display_discount" style="text-align:right !important;">
                                        <span t-field="l.discount"/>
                                    </td>
                                    <td style="text-align:right !important;" id="subtotal">
                                        <span t-field="l.price_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-foreach="l.move_line_ids" t-as="move_line_id">
                                    <tr t-foreach="move_line_id._get_lots()" t-as="lot"
                                        t-attf-style="page-break-inside: avoid !important;">
                                        <td style="text-align:right !important;" colspan="7">
                                            <span class="col-3">
                                                <span>Lot:</span>
                                                <span t-esc="lot['name']"/>
                                            </span>
                                            <span class="col-5">
                                                <t t-if="lot['date_type']">
                                                    <span t-if="lot['date_type'] == 'expiration_date'">Expiry date:</span>
                                                    <span t-if="lot['date_type'] == 'use_date'">Use date:</span>
                                                </t>
                                                <t t-if="lot['date']">
                                                    <span t-esc="lot['date']"/>
                                                </t>
                                            </span>
                                            <span class="col-4">
                                                <span>Quantity:</span>
                                                <span t-esc="lot['qty_formatted']"/>
                                                <span t-esc="lot['uom']"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                        <tr>
                            <td colspan="8"
                                style="border-bottom: 2px solid #ab138a;">
                            </td>
                        </tr>
                        <t t-foreach="o.invoice_line_ids.sorted(key=lambda b: str(b.move_id.invoice_origin))" t-as="l">
                            <t t-if="not l.move_id.invoice_origin">
                                <tr t-attf-style="page-break-inside: avoid !important;">
                                    <!--
                                    <td class="text-center">
                                        <span t-field="l.product_id.image_small"
                                              t-field-options="{&quot;widget&quot;: &quot;image&quot;, &quot;class&quot;: &quot;img-rounded&quot;}"/>
                                    </td>
                                    -->
                                    <td>
                                        <span t-esc="l.name"/>
                                    </td>
                                    <td class="hidden">
                                        <span t-field="l.move_id.invoice_origin"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="l.quantity"/>
                                        <span t-field="l.uom_id" groups="product.group_uom"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="', '.join(map(lambda x: (x.description or x.name), l.tax_ids))"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-if="res_company.show_recommended_price">
                                            <t t-if="l.product_id">
                                                <span t-field="l.product_id.recommended_price"
                                                      t-field-options='{"widget": "monetary", "display_currency": "o.currency_id"}'/>
                                            </t>
                                        </t>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="l.price_unit"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <td t-if="display_discount" class="text-right">
                                        <span t-field="l.discount"/>
                                    </td>
                                    <td class="text-right" id="subtotal">
                                        <span t-field="l.price_subtotal"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-foreach="l.move_line_ids" t-as="move_line_id">
                                    <tr t-foreach="move_line_id._get_lots()" t-as="lot"
                                        t-attf-style="page-break-inside: avoid !important;">
                                        <td class="text-right" colspan="8">
                                            <span class="col-3">
                                                <span>Lot:</span>
                                                <span t-esc="lot['name']"/>
                                            </span>
                                            <span class="col-5">
                                                <t t-if="lot['date_type']">
                                                    <span t-if="lot['date_type'] == 'life_date'">Expiry date:</span>
                                                    <span t-if="lot['date_type'] == 'use_date'">Use date:</span>
                                                </t>
                                                <t t-if="lot['date']">
                                                    <span t-esc="lot['date']"/>
                                                </t>
                                            </span>
                                            <span class="col-4">
                                                <span>Quantity:</span>
                                                <span t-esc="lot['qty_formatted']"/>
                                                <span t-esc="lot['uom']"/>
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </t>
                        <tr t-foreach="range(max(5-len(o.invoice_line_ids),0))" t-as="l"
                            style="border-top:1px solid #ab138a;">
                            <td t-translation="off">&amp;nbsp;</td>
                            <td class="hidden"></td>
                            <td></td>
                            <td t-if="o.partner_id.property_account_position_id and 'com' in o.partner_id.property_account_position_id.name">
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>

                <div class="clearfix">
                    <div id="total" class="row mb32 mt32" style="page-break-inside: avoid !important;">
                        <div class="col-7">
                            <div t-if="o.invoice_payment_term_id">
                                <strong>Payment Term:</strong>
                                <span t-field="o.invoice_payment_term_id.name"/>
                            </div>
                            <t t-set="due_list" t-value="o.get_multi_due_list()" />
                            <div t-if="due_list" class="col-4">               
                                <table class="table table-striped">
                                    <thead>
                                        <tr>
                                            <th>Date Due</th>
                                            <th class="text-right">Amount</th>
                                            <th class="text-right">Outstanding</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="due_list" t-as="due_tuple">
                                            <td>
                                                <span
                                                    t-esc="due_tuple[0]"
                                                    t-options="{'widget': 'date'}"
                                                />
                                            </td>
                                            <td class="text-right">
                                                <span
                                                    t-esc="due_tuple[1]"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                            </td>
                                            <td class="text-right">
                                                <span
                                                    t-esc="due_tuple[2]"
                                                    t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"
                                                />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>                     
                            </div>                            
                            <div t-if="o.payment_mode_id">
                                <strong>Payment Mode:</strong>
                                <span t-field="o.payment_mode_id.name"/>
                            </div>
                            <div t-if="o.mandate_id">
                                <span>
                                    <strong>Bank account:</strong>
                                    <span t-esc="'%sXX XXXX XXXX XXXX XXXX %s' % (o.mandate_id.partner_bank_id.acc_number[:2], o.mandate_id.partner_bank_id.acc_number[-4:])"/>
                                    <br/>
                                    <strong style="color: white;">Bank account:</strong>
                                    <span t-field="o.mandate_id.partner_bank_id.bank_bic"/>
                                    <br/>
                                </span>
                            </div>
                            <div style="margin-top:5px"
                                 t-if="o.payment_mode_id and o.payment_mode_id.variable_journal_ids and o.payment_mode_id.variable_journal_ids[0].bank_account_id">
                                <div>
                                    <span t-field="o.payment_mode_id.variable_journal_ids[0].bank_account_id.bank_id.name"/>
                                </div>
                                <div>
                                    <strong>IBAN:</strong>
                                    <span t-field="o.payment_mode_id.variable_journal_ids[0].bank_account_id.acc_number"/>
                                </div>
                                <div>
                                    <strong>SWIFT CODE:</strong>
                                    <span t-field="o.payment_mode_id.variable_journal_ids[0].bank_account_id.bank_id.bic"/>
                                </div>
                            </div>
                            <t t-if="o.partner_id.property_account_position_id and 'com' in o.partner_id.property_account_position_id.name">
                                <div style="margin-top:5px" t-if="o.invoice_incoterm_id">
                                    <strong>Incoterm:</strong>
                                    <span t-field="o.invoice_incoterm_id.code"/>
                                </div>
                            </t>
                        </div>
                        <div class="col-5 pull-right">
                            <table class="table table-condensed" style="min-width: 250px;max-width: 400px;">
                                <t t-set="tax_totals" t-value="o.tax_totals"/>
                                <t t-call="account.document_tax_totals"/>
                                <!-- COMENTADO EN MIGRACION
                                <tr style="border-top:1px solid #ab138a;">
                                    <td>
                                        <strong>Subtotal</strong>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.amount_untaxed"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                <t t-foreach="o.tax_line_ids" t-as="amount_by_group">
                                    <tr tyle="border-top:1px solid #ab138a;">
                                        <t t-if="len(o.tax_line_ids) == 1 and o.amount_untaxed == amount_by_group.base">
                                            <td>
                                                <span t-esc="amount_by_group.tax_id.tax_group_id.name"/>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="amount_by_group.amount_total"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </t>
                                        <t t-else="">
                                            <td>
                                                <span t-esc="amount_by_group.tax_id.tax_group_id.name"/>
                                                <span>&amp;nbsp;
                                                    <span>on</span>
                                                    <t t-esc="amount_by_group.base"
                                                       t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </span>
                                            </td>
                                            <td class="text-right">
                                                <span t-esc="amount_by_group.amount_total"
                                                      t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                                <tr style="border-top:1px solid #ab138a;">
                                    <td>
                                        <strong>Total</strong>
                                    </td>
                                    <td class="text-right">
                                        <span t-field="o.amount_total"
                                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                                -->
                            </table>
                        </div>
                    </div>
                </div>

                <div t-if="not is_html_empty(o.narration)" name="comment">
                    <p t-if="o.narration" styte="margin-top:15px;">
                        <span t-field="o.narration"/>
                    </p>
                </div>
                <!--
                <div class="text-right col-xs-12" style="color:#CCCCCC;">
                    <span style="font-size:12px;font-weight: bold;" t-field="o.company_id.alq_stamp_signature"/>
                    <div t-if="'Extracom' in o.partner_id.property_account_position_id.name">
                        <span style="font-size:8px;font-style: oblique;"
                              t-field="o.company_id.alq_stamp_signature_note"/>
                    </div>
                </div>
                -->
            </div>
        </t>
    </template>

    <template id="account.report_invoice_with_payments">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.user_id.sudo().lang if o.move_type in ('in_invoice', 'in_refund') else o.partner_id.lang"/>
                <t t-call="custom_reports_dttca.report_invoice_document_alq" t-lang="lang"/>
            </t>
        </t>
    </template>

    <template id="document_tax_totals" inherit_id="account.document_tax_totals">
        <tr class="border-black o_subtotal" position="attributes">
            <attribute name="style">border-top:1px solid #ab138a !important;</attribute>
        </tr>
        <tr class="border-black o_total" position="attributes">
