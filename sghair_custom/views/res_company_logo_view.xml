<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="res_company_logo_list_view" model="ir.ui.view">
    <field name="name">res.company.logo.list.view</field>
    <field name="model">res.company.logo</field>
    <field name="arch" type="xml">
      <list string="Company logos">
        <field name="name" />
        <field name="use_default" />
      </list>
    </field>
  </record>

  <record id="action_company_logos" model="ir.actions.act_window">
    <field name="name">Company logos</field>
    <field name="res_model">res.company.logo</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    id="menu_company_logos"
    action="action_company_logos"
    parent="base.menu_users"
  />
</odoo>
