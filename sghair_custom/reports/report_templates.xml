<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="external_layout_standard_inh_sangrahair"
    inherit_id="web.external_layout_standard"
    priority="100"
  >
    <img t-if="company.logo" position="replace">
      <t
        t-if="o._name not in ('sale.order', 'puchase.order', 'stock.picking', 'account.move')"
      >
        <img
          t-if="company.logo"
          t-att-src="image_data_uri(company.logo)"
          style="max-height: 45px;"
          alt="Logo"
        />
      </t>
      <t
        t-if="o._name in ('sale.order', 'puchase.order', 'stock.picking', 'account.move')"
      >
        <img
          t-if="o.logo_id"
          t-att-src="image_data_uri(o.logo_id.logo)"
          style="max-height: 45px;"
          alt="Logo"
        />
        <img
          t-if="not o.logo_id and company.logo"
          t-att-src="image_data_uri(company.logo)"
          style="max-height: 45px;"
          alt="Logo"
        />
      </t>
    </img>
  </template>

  <template
    id="external_layout_boxed_inh_sangrahair"
    inherit_id="web.external_layout_boxed"
    priority="100"
  >
    <img t-if="company.logo" position="replace">
