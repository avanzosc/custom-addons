      >
        <img t-if="o.logo_id" t-att-src="image_data_uri(o.logo_id.logo)" alt="Logo" />
        <img
          t-if="not o.logo_id and company.logo"
          t-att-src="image_data_uri(company.logo)"
          alt="Logo"
        />
      </t>
    </img>
  </template>

  <template
    id="external_layout_striped_inh_sangrahair"
    inherit_id="web.external_layout_striped"
    priority="100"
  >
    <img t-if="company.logo" position="replace">
      <t
        t-if="o._name not in ('sale.order', 'puchase.order', 'stock.picking', 'account.move')"
      >
        <img
          t-if="company.logo"
          t-att-src="image_data_uri(company.logo)"
          class="float-start"
          alt="Logo"
        />
      </t>
      <t
        t-if="o._name in ('sale.order', 'puchase.order', 'stock.picking', 'account.move')"
