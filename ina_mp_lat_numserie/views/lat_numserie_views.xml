<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="lat_numserie_tree" model="ir.ui.view">
    <field name="name">lat.numserie.tree</field>
    <field name="model">lat.numserie</field>
    <field name="arch" type="xml">
      <list string="Numeros de Serie" editable="top">
        <field name="venta_id" readonly="1" optional="show" />
        <field name="product_id" readonly="1" optional="show" />
        <field name="numserie" readonly="1" optional="show" />
        <field name="production_id" readonly="1" optional="show" />
        <field name="linea_venta_id" readonly="1" optional="show" />
        <field name="peso_sf6" sum="peso_sf6" optional="show" />
        <field name="ensayo" readonly="1" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="lat_numserie_search_view">
    <field name="name">lat.numserie.search.view</field>
    <field name="model">lat.numserie</field>
    <field name="arch" type="xml">
      <search string="Filtros Numeros Serie">
        <field name="numserie" />
        <field name="venta_id" />
        <field name="production_id" />
        <field name="product_id" />
        <field name="ensayo" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Orden de Venta"
            name="group-venta"
            context="{'group_by':'venta_id'}"
          />
          <filter
            string="Producto"
            name="group-producto"
            context="{'group_by':'product_id'}"
          />
          <filter
            string="Ensayo"
            name="group_ensayo"
            domain="[]"
            context="{'group_by':'ensayo'}"
          />
        </group>
      </search>
    </field>
  </record>
  <!--   Action     -->
  <record id="action_lat_numserie" model="ir.actions.act_window">
    <field name="name">Lineas Numeros Individuales</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">lat.numserie</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="ina_mp_lat_numserie.lat_numserie_tree" />
    <field name="search_view_id" ref="ina_mp_lat_numserie.lat_numserie_search_view" />
  </record>
  <!--   Menu       -->
  <menuitem
    name="Lineas Numeros Individuales"
    action="action_lat_numserie"
    id="ina_menu_lat_numserie"
    parent="menu_lat_numserie"
    sequence="600"
  />
</odoo>
