<?xml version="1.0"?>
<odoo>
    <template id="report_delivery_document_alq">
        <t t-call="custom_reports_vmter.external_layout_alq">
            <div class="header" style="font-size: 12px;">
                <div class="row mt16 mb16">
                    <div class="col-6">
                        <div style="font-size: 18px;font-weight: bold;padding-top:10mm">
                            <span>PACKING LIST</span>
                        </div>
                        <div>
                            <span style="font-size: 18px;position: absolute;">
                                <span style="font-weight: bold;">Nº:</span>
                                <span t-field="o.name"/>
                            </span>
                            <span style="font-size: 18px;left:55mm;position: absolute;">
                                <span style="font-weight: bold;">Date:</span>
                                <span t-field="o.scheduled_date" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                            </span>
                        </div>
                        <!--
                        <div t-if="o.sale_id">
                            <span style="font-size: 14px;">
                                <span style="font-weight: bold;">
                                    Customer Order:
                                </span>
                                <span t-field="o.sale_id.client_order_ref"/>
                            </span>
                            <span style="font-size: 14px;left:85mm;position: absolute;">
                                <span style="font-weight: bold;">
                                    Origin:
                                </span>
                                <span t-field="o.origin"/>
                            </span>
                        </div>
                        -->
                    </div>
                    <div class="col-6 text-right">
                        <img src="/custom_reports_vmter/static/src/img/logo_left.png" style="height: 100px;"/>
                    </div>
                </div>
                <div class="row mt16 mb16">
                    <div class="col-6">
                        <!--<t t-if="'Extracom' in o.partner_id.property_account_position_id.name">-->
                        <div style="color: #7F7F7F;font-size: 10px;font-weight: bold;">
                            Seller / Shipper
                        </div>
                        <div style="color: #8B857F;">
                            <div style="font-weight: bold;">
                                <span t-field="o.company_id.partner_id.name"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.street"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.street2"/>
                            </div>
                            <div>
                                <span t-field="o.company_id.zip"/>
                                <span t-field="o.company_id.city"/>
                                (<t t-esc="o.company_id.country_id.name"/>)
                            </div>
                            <div>
                                VAT:
                                <span t-field="o.company_id.vat"/>
                            </div>
                        </div>
                        <div style="color: #8B857F;font-size: 10px;margin-top:2mm;">
                            <div>
                                <i class="fa fa-phone"/>
                                <span t-field="o.company_id.phone"/>
                            </div>
                            <div>
                                <i class="fa fa-at"/>
                                <span t-field="o.company_id.email"/>
                            </div>
                        </div>
                        <t t-if="o.sale_id">
                            <div style="color: #7F7F7F;font-size: 10px;font-weight: bold;margin-top:5mm;">
                                Sales Person:
                            </div>
                            <div style="font-size: 10px;">
                                <div>
                                    <span t-field="o.sale_id.user_id.name"/>
                                </div>
                                <div t-if="o.sale_id.user_id.phone">
                                    <i class="fa fa-phone"/>
                                    <span t-field="o.sale_id.user_id.phone"/>
                                </div>
                                <div t-if="o.sale_id.user_id.email">
                                    <i class="fa fa-at"/>
                                    <span t-field="o.sale_id.user_id.email"/>
                                </div>
                            </div>
                        </t>
                    </div>
                    <div class="col-6">
                        <div style="color: #7F7F7F;font-size: 10px;font-weight: bold;">
                            Delivery / Notify
                        </div>
                        <div name="delivery_address">
                            <div style="font-weight: bold;">
                                <span t-field="o.partner_id.name"/>
                            </div>
                            <div>
                                <span t-field="o.partner_id.street"/>
                            </div>
                            <div>
                                <span t-field="o.partner_id.street2"/>
                            </div>
                            <div>
                                <span t-field="o.partner_id.zip"/>
                                <span t-field="o.partner_id.city"/>
                                (<t t-esc="o.partner_id.country_id.name"/>)
                            </div>
                        </div>
                        <div style="font-size: 10px;margin-top:2mm;">
                            <div t-if="o.partner_id.phone">
                                <i class="fa fa-phone"/>
                                <span t-field="o.partner_id.phone"/>
                            </div>
                            <div t-if="o.partner_id.email">
                                <i class="fa fa-at"/>
                                <span t-field="o.partner_id.email"/>
                            </div>
                        </div>
                        <div t-if="o.sale_id.client_order_ref" style="margin-top:5mm;">
                            <strong>Customer Order:</strong>
                            <span t-field="o.sale_id.client_order_ref"/>
                        </div>
                    </div>
                </div>
                <div class="row mt16 mb16">
                    <div class="col-4">
                        <div t-if="o.origin">
                            <strong>Origin doc.:</strong> <span t-field="o.origin"/>
                        </div>
                        <div>
                          <strong>Weight:</strong>
                          <span t-field="o.shipping_weight"/>
                          <span t-field="o.weight_uom_name"/>
                        </div>
                    </div>
                    <div class="col-4">
                        <div>
                          <strong t-if="o.picking_type_id and o.picking_type_id.code == 'outgoing'">Customer reference:</strong>
                          <strong t-if="o.picking_type_id and o.picking_type_id.code == 'incoming'">Supplier reference:</strong>
                          <span t-if="o.partner_id.parent_id" t-field="o.partner_id.parent_id.ref"/>
                          <span t-if="not o.partner_id.parent_id" t-field="o.partner_id.ref"/>
                        </div>
                        <div>
                          <strong>Packages:</strong> <span t-field="o.number_of_packages"/>
                        </div>
                    </div>
                    <div class="col-4">
                        <div t-if="o.carrier_tracking_ref">
                          <strong>Tracking N.:</strong> <span t-field="o.carrier_tracking_ref"/>
                        </div>
                        <div>
                          <strong>Carrier:</strong> <span t-field="o.carrier_id"/>
                        </div>
                    </div>
                </div>
            </div>
            <div class="page" style="font-size: 11px;">
                <table class="table table-sm" t-if="o.state!='done'">
                    <thead style="border-bottom: 2px solid #598800;">
                        <tr>
                            <th><strong>Product</strong></th>
                            <th><strong>Quantity</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.move_line_ids" t-if="o.move_line_ids"/>
                        <t t-set="lines" t-value="o.move_ids" t-if="not o.move_line_ids"/>
                        <tr t-foreach="lines" t-as="move">
                            <td>
                                <span t-field="move.product_id"/>
                                <p t-if="o.picking_type_code == 'outgoing'">
                                    <span t-field="move.product_id.sudo().description_pickingout"/>
                                </p>
                                <p t-if="o.picking_type_code == 'incoming'">
                                    <span t-field="move.product_id.sudo().description_pickingin"/>
                                </p>
                            </td>
                            <td>
                                <span t-field="move.product_uom_qty"/>
                                <span t-field="move.product_uom"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <table class="table table-sm" t-if="o.move_line_ids and o.state=='done'">
                    <t t-set="has_serial_number" t-value="any(o.mapped('move_line_ids.lot_id'))" groups="stock.group_production_lot"/>
                    <t t-set="has_packages" t-value="any(o.mapped('move_line_ids.result_package_id'))"/>
                    <thead style="border-bottom: 2px solid #598800;">
                        <tr>
                            <th width="50%"><strong>Product</strong></th>
                            <th t-if="has_packages"><strong>Package</strong></th>
                            <t t-if="has_serial_number">
                                <th name="lot_serial">Lot/Serial Number</th>
                                <th name="expiration_date">Expiry Date</th>
                            </t>
                            <th><strong>Quantity</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="o.move_line_ids" t-as="move_line">
                            <td>
                                <span t-field="move_line.product_id"/>
                                <p t-if="o.picking_type_code == 'outgoing'">
                                    <span t-field="move_line.product_id.sudo().description_pickingout"/>
                                </p>
                                <p t-if="o.picking_type_code == 'incoming'">
                                    <span t-field="move_line.product_id.sudo().description_pickingin"/>
                                </p>
                            </td>
                            <t t-if="has_packages">
                               <td>
                                    <span t-field="move_line.result_package_id.name"/>
                               </td>
                            </t>
                            <t t-if="has_serial_number">
                                <td>
                                    <t t-if="move_line.lot_id">
                                        <span t-field="move_line.lot_id"/>
                                    </t>
                                    <t t-elif="move_line.lot_name">
                                        <span t-field="move_line.lot_name"/>
                                    </t>
                                </td>
                                <td>
                                    <span t-field="move_line.lot_id.use_date" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                </td>
                            </t>
                            <td class="text-center">
                                <span t-field="move_line.qty_done"/>
                                <span t-field="move_line.product_uom_id"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <p t-if="o.backorder_id" style="margin-top:15px;">
                    This shipment is a backorder of <t t-esc="o.backorder_id.name"/>.
                </p>
                <p>
                    <t t-if="o.search([('backorder_id', '=', o.id), ('state', 'not in', ['cancel', 'done'])])">
                        All items couldn't be shipped, the remaining ones will be shipped as soon as they become available.
                    </t>
                </p>
            </div>
        </t>
    </template>

    <template id="stock.report_deliveryslip">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="custom_reports_vmter.report_delivery_document_alq" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
