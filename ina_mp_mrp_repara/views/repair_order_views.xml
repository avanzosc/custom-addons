<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_repair_order_tree" model="ir.ui.view">
    <field name="name">ina.repair.order.tree</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_tree" />
    <field name="arch" type="xml">
      <field name="name" position="attributes">
        <attribute name="string">RMA</attribute>
      </field>
      <field name="name" position="after">
        <field name="descripcion" string="Descripcion" optional="show" />
        <field name="workcenter_id" string="Centro" optional="show" />
        <field name="tipo_repara" optional="show" />
        <field name="motivo_repara" optional="show" />
      </field>
    </field>
  </record>

  <record id="ina_repair_order_form" model="ir.ui.view">
    <field name="name">ina.repair.order.form</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form" />
    <field name="arch" type="xml">
      <field name="state" position="attributes">
        <attribute
          name="statusbar_visible"
        >draft,pteconfir,confirmed,under_repair,done</attribute>
      </field>

      <button name="action_validate" position="attributes">
        <attribute name="invisible">state != 'pteconfir'</attribute>
        <attribute name="string">Confirmar</attribute>
      </button>
      <button name="action_validate" position="before">
        <button
          name="action_pte_confir"
          type="object"
          string="Pendiente Confirmar"
          invisible="state != 'draft'"
        />
      </button>
      <button name="action_repair_start" position="before">
        <button
          name="action_crear_materiales"
          type="object"
          string="Crear Materiales"
          groups="ina_mc_permisos.group_inael_calidad_respon"
          invisible="operacion_creada"
        />
      </button>
      <field name="state" position="after">
        <field name="operacion_creada" invisible="1" />
      </field>

      <field name="product_id" position="before">
        <field name="descripcion" />
        <field name="workcenter_id" />
      </field>
      <field name="under_warranty" position="after">
        <field name="tipo_repara" required="1" />
        <field name="motivo_repara" required="1" />
      </field>
      <xpath
        expr="//field[@name='move_ids']/list/field[@name='product_uom_qty']"
        position="after"
      >
        <field name="coste" readonly="1" optional="hide" />
      </xpath>

      <notebook position="inside">
        <page string="Tiempos" name="tiempos">
          <field name="repara_id">
            <list string="Tiempos" editable="bottom">
              <field name="employee_id" />
              <field name="entrada" />
              <field name="salida" />
              <field name="tiempo" widget="float_time" />
              <field name="estado" />
            </list>
          </field>
        </page>
        <page string="Documentacion" name="documentacion">
          <field name="line_documen_ids">
            <list
              string="Documentos"
              editable="bottom"
              decoration-danger="not existe_fichero"
              decoration-success="existe_fichero"
            >
              <field name="fichero" />
              <button
                type="object"
                name="action_ver_docu"
                string="Descargar"
                icon="fa-download"
                invisible="not existe_fichero"
              />
              <field name="carpeta" readonly="1" />
              <field name="existe_fichero" column_invisible="1" />
              <field name="nota" />
            </list>
          </field>
        </page>
      </notebook>
    </field>
  </record>

  <record id="ina_repair_order_search" model="ir.ui.view">
    <field name="name">ina.repair.order.search</field>
    <field name="model">repair.order</field>
    <field name="inherit_id" ref="repair.view_repair_order_form_filter" />
    <field name="arch" type="xml">
      <field name="product_id" position="after">
        <field name="descripcion" />
        <field name="workcenter_id" />
        <field name="tipo_repara" />
        <field name="motivo_repara" />
      </field>
      <filter name="status" position="after">
        <filter
          string="Centro"
          name="group_workcenter"
          domain="[]"
          context="{'group_by': 'workcenter_id'}"
        />
        <filter
          string="Tipo Reparacion"
          name="group_tipo_repara"
          domain="[]"
          context="{'group_by': 'tipo_repara'}"
        />
        <filter
          string="Motivo Reparacion"
          name="group_motivo_repara"
          domain="[]"
          context="{'group_by': 'motivo_repara'}"
        />
      </filter>
    </field>
  </record>
</odoo>
