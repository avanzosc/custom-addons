<?xml version='1.0' encoding='utf-8' ?>
<odoo>
  <template
    id="report_delivery_document"
    inherit_id="stock.report_delivery_document"
    priority="99"
  >
    <xpath expr="//div[contains(@class, 'page')]" position="attributes">
      <attribute name="style">font-size:10pt;</attribute>
    </xpath>
    <h2 position="replace" />
    <t t-set="information_block" position="replace" />
    <t t-set="address" position="replace">
      <t
        t-set="has_hs_code"
        t-value="o.move_ids.filtered(lambda l: l.product_id.hs_code)"
      />
      <div class="row">
        <div class="col-8" nane="div-partner">
          <span>DELIVERY ADDRESS</span>
          <br />
          <strong>
            <span t-field="o.partner_id.name" />
          </strong>
          <br />
          <span t-field="o.partner_id.street" />
          <span t-if="o.partner_id.street2" t-field="o.partner_id.street2" />
          <span t-esc="' - ' + o.partner_id.city" />
          <span t-field="o.partner_id.zip" />
          <span t-esc="o.partner_id.country_id.name" />
          <br />
          <span t-if="o.partner_id.eori_code">EORI: </span>
          <span t-if="o.partner_id.eori_code" t-esc="o.partner_id.eori_code" />
          <spant t-if="o.partner_id.eori_code"> - </spant>
          <span>VAT: </span>
          <span t-esc="o.partner_id.vat" />
          <br />
          <br />
          <br />
        </div>
        <div class="col-4" name="div-h2" style="text-align:right; font-size:18pt;">
          <strong>
                        Delivery note
                        <br />
                        <span
            t-if="o.name and o.name != '/'"
            t-field="o.name"
            style="color:#31669B; font-weight:bold"
          />
                    </strong>
        </div>
      </div>
    </t>

    <div id="informations" position="attributes">
      <attribute name="class">row mb-4</attribute>
    </div>

    <div name="div_origin" position="replace">
      <div class="col-auto me-4 text-center" t-if="o.date_done" name="div_date_done">
        <strong>DATE</strong>
        <div t-field="o.date_done" t-options='{"widget": "date"}' />
      </div>
      <div
        t-if="o.picking_type_id.code == 'outgoing' and o.carrier_id"
        class="col-auto me-4 text-center"
      >
        <strong>CARRIER</strong>
        <div t-field="o.carrier_id" />
      </div>
      <div class="col-auto me-4 text-center" t-if="o.weight" name="div_weight">
        <strong>WEIGHT</strong>
        <br />
        <t t-esc="'%.2f' % o.shipping_weight" />
        <span t-field="o.weight_uom_name" />
      </div>
      <div t-if="o.carrier_tracking_ref" class="col-auto me-4 text-center">
        <strong>TRACKING NUMBER</strong>
        <div t-field="o.carrier_tracking_ref" />
      </div>
      <div t-if="o.origin" class="col-auto me-4 text-center" name="div_origin">
        <strong>LUXAE ORDER</strong>
        <div t-field="o.origin" />
      </div>
    </div>

    <div name="div_sched_date" position="replace">
      <div
        class="col-auto me-4 text-center"
        t-if="o.sudo().sale_id.client_order_ref"
        name="div_client_order_ref"
      >
        <strong>CUSTOMER REFERENCE</strong>
        <div t-esc="o.sudo().sale_id.client_order_ref" />
      </div>
      <div
        class="col-auto me-4 text-center"
        t-if="o.sudo().sale_id.incoterm"
        name="div_incoterm"
      >
        <strong>INCOTERM</strong>
        <div t-esc="o.sudo().sale_id.incoterm.name" />
      </div>
    </div>

    <div name="signature" position="replace" />
    <div t-if="not o.signature" position="replace">
      <p style="text-align: justify; font-size:8pt;">
                The exporter of the products covered by this document (Customs Authorisation No. _____________)
                declares that, except where otherwise clearly indicated, these products are of
                SPAIN preferential origin. Santa Coloma de Gramenet, <span
        t-field="o.date_done"
        t-options='{"widget": "date"}'
      />.
                LUXAE SL (REX: ESREX4661)
            </p>
      <table
        style="width:100%; background:white; border:none; margin-top:10px; border-collapse:collapse;"
      >
        <tr style="background:white; border:none;">
          <td style="text-align:right; border:none; background:white; padding:0;">
            <t t-if="o.company_id.signature_image">
              <img
                t-att-src="image_data_uri(o.company_id.signature_image)"
                style="height:60px; vertical-align:middle;"
              />
            </t>

            <t t-if="o.company_id.stamp_image">
              <img
                t-att-src="image_data_uri(o.company_id.stamp_image)"
                style="height:60px; vertical-align:middle; margin-left:10px;"
              />
            </t>
          </td>
        </tr>
      </table>
    </div>
    <th name="th_sm_product" position="attributes">
      <attribute name="style">font-weight: bold;</attribute>
    </th>
    <th name="th_sm_ordered" position="attributes">
      <attribute name="style">font-weight: bold;</attribute>
    </th>
    <th name="th_sm_quantity" position="attributes">
      <attribute name="style">font-weight: bold;</attribute>
    </th>
    <th name="th_sml_product" position="attributes">
      <attribute name="style">font-weight: bold;</attribute>
    </th>
    <th name="th_sml_qty_ordered" position="attributes">
      <attribute name="style">font-weight: bold;</attribute>
    </th>
    <th name="th_sml_quantity" position="attributes">
      <attribute name="style">font-weight: bold;</attribute>
    </th>
    <th name="lot_serial" position="replace">
      <th
        name="lot_serial"
        style="font-weight: bold !important;"
        t-else=""
      >Lot Number</th>
    </th>
    <xpath expr="//span[@t-field='move.product_uom_qty']/.." position="replace">
      <td class="o_td_quantity text-end">
        <span t-field="move.product_uom_qty" class="text-nowrap" />
        <span t-if="move.product_packaging_id">
                    (<span
          t-field="move.product_packaging_qty"
          t-options='{"widget": "integer"}'
        /> <span t-field="move.product_packaging_id" />)
                </span>
      </td>
    </xpath>
    <xpath expr="//span[@t-field='move.quantity']/.." position="replace">
      <td class="o_td_quantity text-end">
        <span t-field="move.quantity" class="text-nowrap" />
        <span t-if="move.product_packaging_id">
                    (<span
          t-field="move.product_packaging_quantity"
          t-options='{"widget": "integer"}'
        /> <span t-field="move.product_packaging_id" />)
                </span>
      </td>
    </xpath>
  </template>

  <template
    id="report_delivery_document2"
    inherit_id="stock_delivery.report_delivery_document2"
    priority="99"
  >
    <div t-if="o.carrier_tracking_ref" position="replace" />
    <div t-if="o.shipping_weight" position="replace" />
    <div
      t-if="o.picking_type_id.code == 'outgoing' and o.carrier_id"
      position="replace"
    />
    <th t-if="has_hs_code" position="attributes">
      <attribute name="style">font-weight: bold;</attribute>
    </th>
  </template>

  <template
    id="report_delivery_document_inherit_sale_stock"
    inherit_id="sale_stock.report_delivery_document_inherit_sale_stock"
    priority="99"
  >
    <div t-if="o.sudo().sale_id.client_order_ref" position="replace" />
    <div t-if="o.sudo().sale_id.incoterm" position="replace" />
  </template>

  <template
    id="base_signature_fields_template"
    inherit_id="res_company_signature_fields.base_signature_fields_template"
    priority="99"
  >
    <div name="signature_image" position="replace" />
    <div name="stamp_image" position="replace" />
  </template>

  <template
    id="stock_report_delivery_has_serial_move_line"
    inherit_id="stock.stock_report_delivery_has_serial_move_line"
    priority="99"
  >
    <xpath expr="//span[@t-esc='description']/.." position="replace" />
    <span t-field="move_line.product_uom_id" position="replace" />
  </template>

  <template
    id="stock_report_delivery_aggregated_move_lines"
    inherit_id="stock.stock_report_delivery_aggregated_move_lines"
    priority="99"
  >
    <p t-if="aggregated_lines[line]['description']" position="replace" />
    <td name="move_line_aggregated_qty_ordered" position="replace">
      <td class="text-center" name="move_line_aggregated_qty_ordered">
        <span
          t-esc="aggregated_lines[line]['qty_ordered']"
          t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"
        />
        <span t-if="aggregated_lines[line]['packaging'].name">
                    (<span
          t-out="aggregated_lines[line]['packaging_qty']"
          t-options='{"widget": "integer"}'
        /> <span t-out="aggregated_lines[line]['packaging'].name" />)
                </span>
      </td>
    </td>
    <td name="move_line_aggregated_quantity" position="replace">
      <td class="text-center" name="move_line_aggregated_quantity">
        <t t-if="aggregated_lines[line]['quantity']">
          <span
            t-esc="aggregated_lines[line]['quantity']"
            t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"
          />
          <span t-if="aggregated_lines[line]['packaging'].name">
                        (<span
            t-out="aggregated_lines[line]['packaging_quantity']"
            t-options='{"widget": "integer"}'
          /> <span t-out="aggregated_lines[line]['packaging'].name" />)
                    </span>
        </t>
      </td>
    </td>
  </template>
</odoo>
