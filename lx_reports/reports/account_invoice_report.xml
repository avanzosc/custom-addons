<?xml version='1.0' encoding='utf-8' ?>
<odoo>
  <template
    id="report_invoice_document_lx"
    inherit_id="account_invoice_weight.report_invoice_document_luxae"
    priority="99"
  >
    <th name="th_weight" position="replace" />
    <td name="td_weight" position="replace" />
  </template>

  <template
    id="report_invoice_document"
    inherit_id="account.report_invoice_document"
    priority="99"
  >
    <xpath expr="//div[contains(@class, 'page')]" position="attributes">
      <attribute name="style">font-size:10pt;</attribute>
    </xpath>
    <t t-set="layout_document_title" position="replace" />
    <xpath expr="//div[1]" position="replace">
      <div class="row">
        <div class="col-8" nane="div-partner">
          <span>INVOICE TO</span>
          <br />
          <strong>
            <span t-field="o.partner_id.name" />
          </strong>
          <br />
          <span t-field="o.partner_id.street" />
          <span t-if="o.partner_id.street2" t-field="o.partner_id.street2" />
          <span t-esc="' - ' + o.partner_id.city" />
          <span t-field="o.partner_id.zip" />
          <span t-esc="o.partner_id.country_id.name" />
          <br />
          <span t-if="o.partner_id.eori_code">EORI: </span>
          <span t-if="o.partner_id.eori_code" t-esc="o.partner_id.eori_code" />
          <spant t-if="o.partner_id.eori_code"> - </spant>
          <span>VAT: </span>
          <span t-esc="o.partner_id.vat" />
          <br />
          <br />
          <br />
        </div>
        <div class="col-4" name="div-h2" style="text-align:right; font-size:18pt;">
          <strong>
            <span t-if="not proforma" />
            <span t-elif="o.state == 'posted'">PROFORMA</span>
            <span
              t-if="o.move_type == 'out_invoice' and o.state == 'posted'"
            >Invoice</span>
            <span
              t-elif="o.move_type == 'out_invoice' and o.state == 'draft'"
            >Draft Invoice</span>
            <span
              t-elif="o.move_type == 'out_invoice' and o.state == 'cancel'"
            >Cancelled Invoice</span>
            <span
              t-elif="o.move_type == 'out_refund' and o.state == 'posted'"
            >Credit Note</span>
            <span
              t-elif="o.move_type == 'out_refund' and o.state == 'draft'"
            >Draft Credit Note</span>
            <span
              t-elif="o.move_type == 'out_refund' and o.state == 'cancel'"
            >Cancelled Credit Note</span>
            <span t-elif="o.move_type == 'in_refund'">Vendor Credit Note</span>
            <span t-elif="o.move_type == 'in_invoice'">Vendor Bill</span>
            <br />
            <span
              t-if="o.name and o.name != '/'"
              t-field="o.name"
              style="color:#31669B; font-weight:bold"
            />
          </strong>
        </div>
      </div>
    </xpath>
    <div name="customer_code" position="replace" />
    <div name="invoice_date" position="replace">
      <div
        class="col-auto me-4 text-center"
        t-if="o.invoice_date"
        name="invoice_date"
        style="font-size:10pt;"
      >
        <t t-if="o.move_type == 'out_invoice'">
          <strong>DATE</strong>
        </t>
        <t t-elif="o.move_type == 'out_refund'">
          <strong>CREDIT NOTE DATE</strong>
        </t>
        <t t-elif="o.move_type == 'out_receipt'">
          <strong>RECEIPT DATE</strong>
        </t>
        <t t-else="">
          <strong>DATE</strong>
        </t>
        <div t-field="o.invoice_date" />
      </div>
    </div>
    <div name="due_date" position="replace">
      <div
        class="col-auto me-4 text-center"
        t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'"
        name="due_date"
        style="font-size:10pt;"
      >
        <strong>DUE DATE</strong>
        <div t-field="o.invoice_date_due" t-options='{"widget": "date"}' />
      </div>
      <div
        class="col-auto me-4 text-center"
        t-if="o.invoice_payment_term_id"
        name="payment_term"
      >
        <strong>CONDITIONS </strong>
        <div t-field="o.invoice_payment_term_id.name" />
      </div>
    </div>

    <div name="delivery_date" position="replace">
      <div
        class="col-auto me-4 text-center"
        t-if="o.delivery_date"
        name="delivery_date"
      >
        <strong>DELIVERY DATE</strong>
        <div t-field="o.delivery_date" />
      </div>
    </div>
    <div class="col" name="origin" position="replace">
      <div class="col-auto me-4 text-center" t-if="o.invoice_origin" name="origin">
        <strong>SOURCE</strong>
        <div t-field="o.invoice_origin" />
      </div>
    </div>
    <div name="reference" position="replace">
      <div class="col-auto me-4 text-center" t-if="o.ref" name="reference">
        <strong>REFERENCE</strong>
        <div t-field="o.ref" />
      </div>
    </div>
    <div name="incoterm_id" position="replace">
      <div
        class="col-auto me-4 text-center"
        t-if="o.invoice_incoterm_id"
        name="incoterm_id"
      >
        <strong>INCOTERM</strong>
        <div t-if="o.incoterm_location">
          <span t-field="o.invoice_incoterm_id.code" />
          <br />
          <span t-field="o.incoterm_location" />
        </div>
        <div t-else="" t-field="o.invoice_incoterm_id.code" class="m-0" />
      </div>
    </div>

    <th name="th_description" position="attributes">
      <attribute name="style">font-weight: bold</attribute>
    </th>
    <th name="th_quantity" position="replace">
      <th name="th_quantity" style="font-weight: bold;" class="text-end">
        <span>Quantity</span>
      </th>
      <th name="th_hs_code" style="font-weight: bold;" class="text-center">
        <span>HS Code</span>
      </th>
    </th>
    <th name="th_priceunit" position="replace">
      <th
        name="th_priceunit"
        style="font-weight: bold;"
        t-attf-class="text-end text-nowrap {{ 'd-none d-md-table-cell' if report_type == 'html' else '' }}"
      >
        <span>Unit Price</span>
      </th>
    </th>
    <th name="th_discount" position="attributes">
      <attribute name="style">font-weight: bold</attribute>
    </th>
    <th name="th_subtotal" position="attributes">
      <attribute name="style">font-weight: bold</attribute>
    </th>
    <span t-field="line.product_uom_id" position="replace" />
    <span t-field="line.price_unit" position="replace">
      <span class="text-nowrap" t-esc="'%.2f' % line.price_unit" />
    </span>
    <th name="th_taxes" position="replace" />
    <td name="td_taxes" position="replace" />
    <td name="td_price_unit" position="before">
      <td name="td_hs_code">
        <span t-field="line.product_id.hs_code" t-options="{'widget': 'text'}" />
      </td>
    </td>
    <div class="clearfix invoice_main" position="after">
      <p style="text-align: justify; font-size:8pt;">
                The exporter of the products covered by this document (Customs Authorisation No. )
                declares that, except where otherwise clearly indicated, these products are of
                SPAIN preferential origin. Santa Coloma de Gramenet, <span
        t-field="o.invoice_date"
      />.
                LUXAE SL (REX: ESREX4661)
            </p>

      <table
        style="width:100%; background:white; border:none; margin-top:10px; border-collapse:collapse;"
      >
        <tr style="background:white; border:none;">
          <td style="text-align:right; border:none; background:white; padding:0;">
            <t t-if="o.company_id.signature_image">
              <img
                t-att-src="image_data_uri(o.company_id.signature_image)"
                style="height:60px; vertical-align:middle;"
              />
            </t>

            <t t-if="o.company_id.stamp_image">
              <img
                t-att-src="image_data_uri(o.company_id.stamp_image)"
                style="height:60px; vertical-align:middle; margin-left:10px;"
              />
            </t>
          </td>
        </tr>
      </table>
    </div>
  </template>
</odoo>
