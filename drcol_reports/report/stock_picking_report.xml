<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template id="report_picking" inherit_id="stock.report_picking" priority="99">
    <th name="th_product" position="before">
      <th name="th_sku">
        <div align="left">
          <strong>SKU</strong>
        </div>
      </th>
    </th>
    <xpath expr="//span[@t-field='ml.product_id.display_name']/.." position="before">
      <td name="td_sku">
        <span t-field="ml.product_id.default_code" />
      </td>
    </xpath>
    <span t-field="ml.product_id.display_name" position="replace">
      <span t-field="ml.product_id.name" />
    </span>
    <span t-field="ml.quantity" position="replace">
      <span t-esc="int(ml.quantity or 0)" class="text-nowrap" />
    </span>
    <span t-field="ml.product_uom_id" position="replace" />
    <p t-field="o.note" position="replace">
      <table t-if="o.note" width="100%" style="border-collapse: collapse;">
        <tr>
          <td
            style="border: 1px solid black !important;
                                background-color: white !important;
                                color: black !important;
                               padding: 5px;"
          >
            <div
              style="color: black !important;
                                    background-color: white !important;"
            >
              <span t-field="o.note" />
            </div>
          </td>
        </tr>
      </table>
    </p>
  </template>

  <template
    id="report_delivery_document2"
    inherit_id="stock_delivery.report_delivery_document2"
    priority="99"
  >
    <div t-if="o.shipping_weight" position="replace" />
    <th t-if="has_hs_code" position="replace" />
    <th t-if="has_hs_code" position="replace" />
    <td t-if="has_hs_code" position="replace" />
  </template>

  <template
    id="stock_report_delivery_has_serial_move_line_inherit_delivery"
    inherit_id="stock_delivery.stock_report_delivery_has_serial_move_line_inherit_delivery"
    priority="99"
  >
    <td t-if="has_hs_code" position="replace" />
  </template>

  <template
    id="stock_report_delivery_aggregated_move_lines_inherit_delivery"
    inherit_id="stock_delivery.stock_report_delivery_aggregated_move_lines_inherit_delivery"
    priority="99"
  >
    <td t-if="has_hs_code" position="replace" />
  </template>

  <template
    id="report_delivery_document_inherit_sale_stock"
    inherit_id="sale_stock.report_delivery_document_inherit_sale_stock"
    priority="99"
  >
    <div t-if="o.sudo().sale_id.client_order_ref" position="replace" />
  </template>

  <template
    id="report_delivery_document"
    inherit_id="stock.report_delivery_document"
    priority="99"
  >
    <t t-set="address" position="replace" />
    <t t-set="information_block" position="replace">
      <div class="row mb-4">
        <div class="col-6" name="div_outgoing_address">
          <div t-if="o.should_print_delivery_address()">
            <span>
              <strong>Delivery Address:</strong>
            </span>
            <div
              t-out="o.move_ids[0].partner_id or o.partner_id"
              t-options='{"widget": "contact", "fields": ["address", "name", "phone"], "no_marker": True, "phone_icons": True}'
            >
              <div
                class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 opacity-75 text-muted text-center"
              >
                <strong>Delivery address</strong>
                <div>Presence depends on the type of operation.</div>
              </div>
            </div>
          </div>
          <div
            t-elif="o.picking_type_id.code != 'internal' and o.picking_type_id.warehouse_id.partner_id"
          >
            <strong>Warehouse Address</strong>
            <div
              t-field="o.picking_type_id.warehouse_id.partner_id"
              t-options='{"widget": "contact", "fields": ["name", "phone"], "no_marker": True, "phone_icons": True}'
            >
              <div
                class="bg-light border-1 rounded h-100 d-flex flex-column align-items-center justify-content-center p-4 opacity-75 text-muted text-center"
              >
                <strong>Warehouse address</strong>
                <div>Presence depends on the type of operation.</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </t>
    <div t-field="o.date_done" position="attributes">
      <attribute name="t-options">{"widget": "date"}</attribute>
    </div>
    <div t-field="o.scheduled_date" position="attributes">
      <attribute name="t-options">{"widget": "date"}</attribute>
    </div>

    <div t-if="o.origin" position="after">
      <div
        t-if="o.sudo().sale_id.client_order_ref"
        class="col col-3 mw-100 mb-2"
        name="div_origin"
      >
        <strong>Customer Reference</strong>
        <div t-field="o.sudo().sale_id.client_order_ref" class="m-0" />
      </div>
    </div>
    <th name="th_sm_ordered" position="replace" />
    <xpath expr="//span[@t-field='move.product_uom_qty']/.." position="replace" />
    <th name="th_sm_product" position="before">
      <th name="th_sm_sku">
        <strong>SKU</strong>
      </th>
    </th>
    <xpath expr="//span[@t-field='move.product_id']/.." position="before">
      <td Name="td_sm_sku">
        <span t-field="move.product_id.default_code" />
      </td>
    </xpath>
    <span t-field="move.product_id" position="replace">
      <span t-field="move.product_id.name" />
    </span>
    <span t-field="move.product_uom" position="replace" />
    <th name="th_sml_product" position="before">
      <th name="th_sml_sku">SKU</th>
    </th>
    <div t-if="not o.signature" position="before">
      <table t-if="o.note" width="100%" style="border-collapse: collapse;">
        <tr>
          <td
            style="border: 1px solid black !important;
                                background-color: white !important;
                                color: black !important;
                               padding: 5px;"
          >
            <div
              style="color: black !important;
                                    background-color: white !important;"
            >
              <span t-field="o.note" />
            </div>
          </td>
        </tr>
      </table>
    </div>
    <th name="lot_serial" position="attributes">
      <attribute name="t-else" />
      <attribute name="t-if">has_serial_number</attribute>
    </th>
    <th name="th_sml_qty_ordered" position="replace" />
  </template>

  <template
    id="stock_report_delivery_has_serial_move_line"
    inherit_id="stock.stock_report_delivery_has_serial_move_line"
    priority="99"
  >
    <xpath expr="//span[@t-field='move_line.product_id']/.." position="replace">
      <td>
        <span t-field="move_line.product_id.default_code" />
      </td>
      <td>
        <span t-field="move_line.product_id.name" />
        <p
          t-if="move_line.move_id.description_picking and move_line.move_id.description_picking != move_line.move_id.product_id.name and move_line.move_id._get_report_description_picking()"
        >
          <span t-out="move_line.move_id._get_report_description_picking()" />
        </p>
      </td>
      <span t-field="move_line.quantity" position="replace">
        <span t-field="move.product_uom_qty" position="replace">
          <span t-esc="int(move_line.quantity or 0)" class="text-nowrap" />
        </span>
      </span>
      <span t-field="move_line.product_uom_id" position="replace" />
    </xpath>
  </template>

  <template
    id="stock_report_delivery_aggregated_move_lines"
    inherit_id="stock.stock_report_delivery_aggregated_move_lines"
    priority="99"
  >
    <xpath expr="//td[1]" position="replace">
      <td>
        <span t-esc="aggregated_lines[line]['product'].default_code" />
      </td>
      <td>
        <span t-esc="aggregated_lines[line]['product'].name" />
        <p t-if="aggregated_lines[line]['description']">
          <span
            t-esc="aggregated_lines[line]['description']"
            t-options="{'widget': 'text'}"
          />
        </p>
      </td>
    </xpath>

    <td name="move_line_aggregated_qty_ordered" position="replace">
      <td
        class="text-center"
        name="move_line_aggregated_qty_ordered"
        t-if="has_serial_number"
      >
        <span
          t-esc="int(aggregated_lines[line]['qty_ordered'])"
          t-options="{'widget': 'integer', 'decimal_precision': 'Product Unit of Measure'}"
        />
        <span t-if="aggregated_lines[line]['packaging'].name">
                    (<span
          t-out="int(aggregated_lines[line]['packaging_qty'])"
          t-options='{"widget": "integer"}'
        /> <span t-out="aggregated_lines[line]['packaging'].name" />)
                 </span>
      </td>
    </td>
    <td name="move_line_aggregated_quantity" position="replace">
      <td class="text-center" name="move_line_aggregated_quantity">
        <t t-if="aggregated_lines[line]['quantity']">
          <span
            t-esc="int(aggregated_lines[line]['quantity'])"
            t-options="{'widget': 'integer', 'decimal_precision': 'Product Unit of Measure'}"
          />
          <span t-if="aggregated_lines[line]['packaging'].name">
                        (<span
            t-out="int(aggregated_lines[line]['packaging_quantity'])"
            t-options='{"widget": "integer"}'
          /> <span t-out="aggregated_lines[line]['packaging'].name" />)
                     </span>
        </t>
      </td>
    </td>
  </template>
</odoo>
