<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_saleorder_document"
    inherit_id="sale.report_saleorder_document"
    priority="9999"
  >
    <t t-call="web.external_layout" position="attributes">
      <attribute name="t-call">spcrp_reports.external_layout_sale</attribute>
    </t>
    <!-- redefining the table header -->
    <xpath
      expr="//table[hasclass('o_main_table')]/thead//th[count(//span[@t-esc=&quot;', '.join(map(lambda x: (x.description or x.name), line.tax_id))&quot;]/../preceding-sibling::*) + 1]"
      position="attributes"
    >
      <attribute name="class" separator=" " add="d-none" />
    </xpath>
    <xpath
      expr="//table[hasclass('o_main_table')]/thead//th[count(//span[@t-field='line.name']/../preceding-sibling::*) + 1]"
      position="before"
    >
      <th class="text-left" name="th_sequence">Sequence</th>
      <th class="text-left" name="th_image">Image</th>
    </xpath>
    <th name="th_description" position="after">
      <th class="text-left" name="th_packaging">Packaging</th>
    </th>
    <!-- redefining the table body -->
    <xpath
      expr="//table[hasclass('o_main_table')]/tbody//span[@t-field='line.name']/.."
      position="before"
    >
      <td>
        <span
          t-field="line.product_id.image_128"
          t-options="{'widget': 'image', 'class': 'rounded'}"
        />
      </td>
    </xpath>
    <xpath
      expr="//table[hasclass('o_main_table')]/tbody//span[@t-field='line.name']/.."
      position="attributes"
    >
      <attribute name="style" separator=" " add="vertical-align: middle;" />
    </xpath>
    <xpath
      expr="//table[hasclass('o_main_table')]/tbody//span[@t-field='line.name']/.."
      position="after"
    >
      <td style="vertical-align: middle;">
        <span t-field="line.product_packaging_id" />
        <t t-if="not line.product_packaging_id.qty == 0">
                    <t
          t-set="unidades"
          t-value="line.product_uom_qty/line.product_packaging_id.qty"
        />
                    (<span t-esc="str('%.0f'%(unidades)).replace('.',',')" /> uds.)
                </t>
      </td>
    </xpath>
    <xpath
      expr="//table[hasclass('o_main_table')]/tbody//span[@t-field='line.product_uom_qty']/.."
      position="attributes"
    >
      <attribute name="style" separator=" " add="vertical-align: middle;" />
    </xpath>
    <xpath
      expr="//table[hasclass('o_main_table')]/tbody//span[@t-field='line.price_unit']/.."
      position="replace"
    >
      <td class="text-right" style="vertical-align: middle;">
        <t t-if="not display_discount">
          <span t-field="line.price_unit" />
        </t>
        <t t-else="">
          <t
            t-if="line.discount in (60.00, 57.50, 55.00, 52.50, 50.00, 46.00, 45.00, 44.20, 43.00, 41.80, 40.00, 38.00, 35.00)"
          >
            <span t-field="line.price_unit" />
          </t>
          <t t-else="">
            <t
              t-set="precio_unidad"
              t-value="line.price_subtotal/line.product_uom_qty"
            />
            <span t-esc="str('%.2f'%(precio_unidad)).replace('.',',')" />
          </t>
        </t>
      </td>
    </xpath>
    <xpath
      expr="//table[hasclass('o_main_table')]/tbody//span[@t-field='line.discount']/.."
      position="replace"
    >
      <td
        t-if="display_discount"
        style="vertical-align: middle;"
        class="text-right"
        groups="sale.group_discount_per_so_line"
      >
        <t t-if="line.discount == 60.00">
          <span>50%+20%</span>
        </t>
        <t t-if="line.discount == 57.50">
          <span>50%+15%</span>
        </t>
        <t t-if="line.discount == 55.00">
          <span>50%+10%</span>
        </t>
        <t t-if="line.discount == 52.50">
          <span>50%+5%</span>
        </t>
        <t t-if="line.discount == 50.00">
          <span>50%</span>
        </t>
        <t t-if="line.discount == 46.00">
          <span>40%+10%</span>
        </t>
        <t t-if="line.discount == 45.00">
          <span>45%</span>
        </t>
        <t t-if="line.discount == 44.20">
          <span>40%+7%</span>
        </t>
        <t t-if="line.discount == 43.00">
          <span>40%+5%</span>
        </t>
        <t t-if="line.discount == 41.80">
          <span>40%+3%</span>
        </t>
        <t t-if="line.discount == 40.00">
          <span>40%</span>
        </t>
        <t t-if="line.discount == 38.00">
          <span>38%</span>
        </t>
        <t t-if="line.discount == 35.00">
          <span>35%</span>
        </t>
      </td>
    </xpath>
    <xpath
      expr="//table[hasclass('o_main_table')]/tbody//span[@t-field='line.price_subtotal']/.."
      position="attributes"
    >
      <attribute name="style" separator=" " add="vertical-align: middle;" />
    </xpath>
    <th name="th_taxes" position="replace" />
    <td name="td_taxes" position="replace" />
  </template>

  <template id="report_saleorder_document_labels">
    <div
      class="article"
      t-att-data-oe-model="o and o._name"
      t-att-data-oe-id="o and o.id"
      t-att-data-oe-lang="o and o.env.context.get('lang')"
    >
      <div class="page">
        <t t-set="k" t-value="0" />
        <t t-set="j" t-value="0" />
        <t t-foreach="doc.order_line" t-as="l">
          <t t-if="not l.display_type">
            <span t-if="not l.product_packaging_id.qty == 0">
              <t
                t-foreach="int(float(l.product_uom_qty/l.product_packaging_id.qty))"
                t-as="i"
              >
                <div style="width:41% !important;float:left;padding-top:-70px;">
                  <span t-if="l.product_packaging_id.name=='CAJA GRANDE'">
                    <span
                      t-field="l.product_id.pegatinacaja"
                      t-options="{'widget': 'image'}"
                    />
                    <t t-set="k" t-value="k+1" />
                  </span>
                  <span t-if="l.product_packaging_id.name==u'CAJA PEQUEÑA'">
                    <span
                      t-field="l.product_id.codigobarras"
                      t-options="{'widget': 'image'}"
                    />
                    <t t-set="j" t-value="j+1" />
                  </span>
                </div>
              </t>
            </span>
          </t>
        </t>
        <div style="float:left;">
          <h1>Nº de cajas grandes: <span t-esc="k" /></h1>
        </div>
        <div style="float:left;">
          <h1>Nº de cajas pequeñas: <span t-esc="j" /></h1>
        </div>
      </div>
    </div>
  </template>

  <template id="report_saleorder_labels">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">
        <t
          t-call="spcrp_reports.report_saleorder_document_labels"
          t-lang="doc.partner_id.lang"
        />
      </t>
    </t>
  </template>

  <record id="report_sale_order_labels" model="ir.actions.report">
    <field name="name">Print Cage labels</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">spcrp_reports.report_saleorder_labels</field>
    <field name="report_file">spcrp_reports.report_saleorder_labels</field>
    <field name="print_report_name">'Sale Label - %s' % (object.name)</field>
    <field name="binding_model_id" ref="sale.model_sale_order" />
    <field name="binding_type">report</field>
  </record>
</odoo>
