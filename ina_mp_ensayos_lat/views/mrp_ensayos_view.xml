<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_mrp_ensayos_tree" model="ir.ui.view">
    <field name="name">ina.mrp.ensayos.tree</field>
    <field name="model">mrp.ensayos</field>
    <field name="arch" type="xml">
      <list string="Ensayos" editable="top">
        <field name="name" optional="show" />
        <field name="code" optional="show" />
      </list>
    </field>
  </record>

  <!--    EL GENERICO, PRINCIPAL  -->
  <menuitem
    id="menu_mrp_ensayos"
    name="Ensayos"
    parent="mrp.menu_mrp_root"
    sequence="23"
  />

  <record id="action_ina_mrp_ensayos" model="ir.actions.act_window">
    <field name="name">Ensayos</field>
    <field name="res_model">mrp.ensayos</field>
    <field name="type">ir.actions.act_window</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem
    name="Ensayos"
    action="action_ina_mrp_ensayos"
    id="ina_menu_mrp_ensayos"
    parent="menu_mrp_ensayos"
    sequence="10"
  />

  <!--   PONGO AQUI TAMBIEN LOS ENSAYOS QUE ESTAN EN FABRICA -->
  <menuitem
    name="Ensayos"
    action="ina_mp_ensayos_lat.action_ina_mrp_ensayos"
    id="ina_menu_mrp_ensayos"
    parent="ina_mp_lat_res_ensayos.menu_lat_ensayos"
    sequence="10"
  />
</odoo>
