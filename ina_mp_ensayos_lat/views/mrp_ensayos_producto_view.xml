<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_mrp_ensayos_prod_tree" model="ir.ui.view">
    <field name="name">ina.mrp.ensayos.producto.tree</field>
    <field name="model">mrp.ensayos.producto</field>
    <field name="arch" type="xml">
      <list string="Ensayos Producto" editable="top">
        <field name="product_id" optional="show" />
        <field name="ensayo_id" optional="show" />
        <field name="nominal" optional="show" />
        <field name="minimo" optional="show" />
        <field name="maximo" optional="show" />
        <field name="etiqueta" optional="show" />
        <field name="nota" optional="show" />
      </list>
    </field>
  </record>

  <record model="ir.ui.view" id="ina_mrp_ensayos_prod_search_view">
    <field name="name">ina.mrp.ensayos.prod.search.view</field>
    <field name="model">mrp.ensayos.producto</field>
    <field name="arch" type="xml">
      <search string="Filtros Ensayos">
        <field name="product_id" />
        <field name="ensayo_id" />
        <separator />
        <group expand="0" string="Group By">
          <filter
            string="Producto"
            name="group-producto"
            context="{'group_by':'product_id'}"
          />
          <filter
            string="Ensayo"
            name="group-ensayo"
            context="{'group_by':'ensayo_id'}"
          />
        </group>
      </search>
    </field>
  </record>

  <record id="action_ina_mrp_ensayos_prod" model="ir.actions.act_window">
    <field name="name">Ensayos por Producto</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">mrp.ensayos.producto</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="ina_mp_ensayos_lat.ina_mrp_ensayos_prod_tree" />
    <field
      name="search_view_id"
      ref="ina_mp_ensayos_lat.ina_mrp_ensayos_prod_search_view"
    />
  </record>

  <menuitem
    name="Ensayos por Producto"
    action="action_ina_mrp_ensayos_prod"
    id="ina_menu_mrp_ensayos_prod"
    parent="menu_mrp_ensayos"
    sequence="12"
  />

  <!--   PONGO AQUI TAMBIEN LOS ENSAYOS QUE ESTAN EN FABRICA -->
  <menuitem
    name="Ensayos por Producto"
    action="ina_mp_ensayos_lat.action_ina_mrp_ensayos_prod"
    id="ina_menu_mrp_ensayos_prod"
    parent="ina_mp_lat_res_ensayos.menu_lat_ensayos"
    sequence="30"
  />
</odoo>
