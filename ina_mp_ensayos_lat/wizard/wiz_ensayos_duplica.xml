<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="wiz_ensayos_duplica" model="ir.ui.view">
    <field name="name">wiz_ensayos_duplica</field>
    <field name="model">wiz.ensayos.duplica</field>
    <field name="arch" type="xml">
      <form string="Wizard para Duplicar Ensayos">
        <group>
             Duplicar ensayos de un producto
          </group>
        <group string="Producto">
          <field name="product_id" />
        </group>
        <footer>
          <button
            icon="gtk-execute"
            name="wiz_duplica_ensayo"
            string="Duplicar Ensayo"
            type="object"
            class="oe_highlight"
          />
          <button
            icon="gtk-cancel"
            string="Cancelar"
            class="oe_link"
            special="cancel"
          />
        </footer>
      </form>
    </field>
  </record>

  <record id="action_wiz_ensayos_duplica" model="ir.actions.act_window">
    <field name="name">Duplicar Ensayos</field>
    <field name="res_model">wiz.ensayos.duplica</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
    <field
      name="binding_model_id"
      ref="ina_mp_ensayos_lat.model_mrp_ensayos_producto"
    />
    <field name="binding_view_types">form</field>
  </record>
</odoo>
