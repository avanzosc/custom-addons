<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_saleorder_document"
    inherit_id="sale.report_saleorder_document"
    priority="99"
  >
    <t t-set="layout_document_title" position="replace">
      <t t-set="layout_document_title">
        <span t-if="is_proforma">Pro-Forma</span>
        <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
        <span t-else="">Order # </span>
        <span t-field="doc.name" />
      </t>
    </t>
    <span t-field="line.name" position="replace">
      <t t-if="line.product_id and line.product_id.name != line.name">
        <span
          t-esc="line.name.replace(line.product_id.name + '\n', '', 1)"
          style="white-space: pre-line;"
        />
      </t>
      <t t-else="">
        <span t-field="line.name" />
      </t>
    </span>
  </template>
</odoo>
