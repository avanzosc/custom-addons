<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_saleorder_document"
    inherit_id="sale.report_saleorder_document"
    priority="110"
  >
    <t t-set="layout_document_title" position="replace">
      <t t-set="layout_document_title">
        <span t-if="is_proforma">Pro-Forma</span>
        <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
        <span t-else="">Order # </span>
        <span t-field="doc.name" />
      </t>
    </t>
    <span t-field="line.name" position="replace">
      <span t-field="line.product_id.display_name" />
    </span>
    <td t-if="not line.is_downpayment" name="td_subtotal" position="after">
      <t
        t-set="product_name"
        t-value="line.product_id.with_context(lang=line.order_id.partner_id.lang).display_name"
      />
      <t t-if="product_name in line.name">
        <t t-set="line_name" t-value="line.name.replace(product_name + '\n', '', 1)" />
      </t>
      <t t-else="">
        <t t-set="line_name" t-value="line.name" />
      </t>

      <tr
        t-if="not line.display_type and line.product_type != 'combo' and line_name != line.name"
      >
        <td name="td_name_full" colspan="99">
          <span t-esc="line_name" />
        </td>
      </tr>
    </td>
    <th name="th_taxes" position="replace" />
    <td name="td_taxes" position="replace" />
  </template>
</odoo>
