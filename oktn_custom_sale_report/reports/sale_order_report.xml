<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <template
    id="report_saleorder_document"
    inherit_id="sale.report_saleorder_document"
    priority="99"
  >
    <t t-set="layout_document_title" position="replace">
      <t t-set="layout_document_title">
        <span t-if="is_proforma">Pro-Forma</span>
        <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
        <span t-else="">Order # </span>
        <span t-field="doc.name" />
      </t>
    </t>
    <span t-field="line.name" position="replace">
      <t
        t-set="product_name_es"
        t-value="line.product_id.with_context(lang=user.lang).display_name"
      />
      <t
        t-if="line.product_id and line.product_id.no_product_description_to_sale_invoice_lines and product_name_es in line.name"
      >
        <span
          t-esc="line.name.replace(product_name_es + '\n', '', 1)"
          style="white-space: pre-line;"
        />
      </t>
      <t t-else="">
        <span t-field="line.name" />
      </t>
    </span>
    <th name="th_taxes" position="replace" />
    <td name="td_taxes" position="replace" />
  </template>
</odoo>
