<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="ina_mp_product_cia_tree_view" model="ir.ui.view">
    <field name="name">ina_mp_product_cia_tree_view</field>
    <field name="model">product.cia</field>
    <field name="arch" type="xml">
      <list string="Compañias" editable="bottom">
        <field name="id" readonly="1" />
        <field name="name" />
      </list>
    </field>
  </record>

  <record id="action_product_cia" model="ir.actions.act_window">
    <field name="name">Compañias</field>
    <field name="res_model">product.cia</field>
    <field name="view_mode">list</field>
  </record>

  <menuitem
    action="action_product_cia"
    name="Compañias Electricas"
    id="product_cia_ina_menu"
    parent="sale.menu_sale_config"
    sequence="20"
  />
</odoo>
