<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="crm_lead_type_tree_view" model="ir.ui.view">
    <field name="name">crm.lead_type.tree.view</field>
    <field name="model">type</field>
    <field name="arch" type="xml">
      <list string="Types (master)" editable="top">
        <field name="name" />
      </list>
    </field>
  </record>

  <record id="crm_lead_type_action" model="ir.actions.act_window">
    <field name="name">Types</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">type</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="crm_lead_type_tree_view" />
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

  <menuitem
    id="menu_crm_lead_type"
    action="crm_lead_type_action"
    parent="crm_custom_menu_config"
    sequence="30"
  />
</odoo>
