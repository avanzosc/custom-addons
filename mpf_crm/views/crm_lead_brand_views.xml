<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
  <record id="crm_lead_brand_tree_view" model="ir.ui.view">
    <field name="name">crm.lead_brand.tree.view</field>
    <field name="model">brand</field>
    <field name="arch" type="xml">
      <list string="Master of brands" editable="top">
        <field name="name" />
      </list>
    </field>
  </record>

  <record id="crm_lead_brand_action" model="ir.actions.act_window">
    <field name="name">Brands</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">brand</field>
    <field name="view_mode">list</field>
    <field name="view_id" ref="crm_lead_brand_tree_view" />
    <field name="domain">[]</field>
    <field name="context">{}</field>
  </record>

  <menuitem
    id="menu_crm_lead_brand"
    action="crm_lead_brand_action"
    parent="crm_custom_menu_config"
    sequence="20"
  />
</odoo>
