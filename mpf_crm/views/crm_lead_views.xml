<odoo>
  <record id="crm_lead_view_form" model="ir.ui.view">
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_lead_view_form" />
    <field name="arch" type="xml">
      <button name="action_schedule_meeting" position="after">
        <button
          class="oe_stat_button"
          type="object"
          name="action_view_sale_cancelled_quotation"
          icon="fa-pencil-square-o"
          invisible="type == 'lead'"
        >
          <field
            name="cancelled_quotation_count"
            widget="statinfo"
            string="Pres.cancel."
          />
        </button>
      </button>
      <field name="tag_ids" position="after">
        <field name="lead_type_id" string="Type" />
        <field name="belong_id" string="It belongs to" />
        <field name="brand_id" string="Brand" />
      </field>
    </field>
  </record>

  <record id="view_crm_case_opportunities_filter" model="ir.ui.view">
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
    <field name="arch" type="xml">
      <field name="lead_properties" position="after">
        <separator />
        <field name="lead_type_id" string="Type" />
        <field name="belong_id" string="It belongs to" />
        <field name="brand_id" string="Brand" />
      </field>
      <filter name="source" position="after">
        <filter
          string="Type"
          name="lead_type"
          domain="[]"
          context="{'group_by':'lead_type_id'}"
        />
        <filter
          string="It belongs to"
          name="belong"
          domain="[]"
          context="{'group_by':'belong_id'}"
        />
        <filter
          string="Brand"
          name="brand"
          domain="[]"
          context="{'group_by':'brand_id'}"
        />
      </filter>
    </field>
  </record>

  <record id="view_crm_case_leads_filter" model="ir.ui.view">
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.view_crm_case_leads_filter" />
    <field name="arch" type="xml">
      <field name="lead_properties" position="after">
        <separator />
        <field name="lead_type_id" string="Type" />
        <field name="belong_id" string="It belongs to" />
        <field name="brand_id" string="Brand" />
      </field>
      <filter name="source" position="after">
        <filter
          string="Type"
          name="lead_type"
          domain="[]"
          context="{'group_by':'lead_type_id'}"
        />
        <filter
          string="It belongs to"
          name="belong"
          domain="[]"
          context="{'group_by':'belong_id'}"
        />
        <filter
          string="Brand"
          name="brand"
          domain="[]"
          context="{'group_by':'brand_id'}"
        />
      </filter>
    </field>
  </record>

  <record id="crm_opportunity_report_view_search" model="ir.ui.view">
    <field name="model">crm.lead</field>
    <field name="inherit_id" ref="crm.crm_opportunity_report_view_search" />
    <field name="arch" type="xml">
      <field name="user_id" position="after">
        <separator />
        <field name="lead_type_id" string="Type" />
        <field name="belong_id" string="It belongs to" />
        <field name="brand_id" string="Brand" />
      </field>
      <filter name="source" position="after">
        <filter
          string="Type"
          name="lead_type"
          domain="[]"
          context="{'group_by':'lead_type_id'}"
        />
        <filter
          string="It belongs to"
          name="belong"
          domain="[]"
          context="{'group_by':'belong_id'}"
        />
        <filter
          string="Brand"
          name="brand"
          domain="[]"
          context="{'group_by':'brand_id'}"
        />
      </filter>
    </field>
  </record>
</odoo>
