<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_alq">
        <t t-call="dttca_custom_reports.external_layout_alq">
            <div class="header" style="font-size: 12px;">
                <div class="row mt16 mb16">
                    <div class="col-6">
                        <div style="font-size: 18px;font-weight: bold;padding-top:10mm">
                            <t t-if="env.context.get('proforma', False) or is_pro_forma">
                                <span style="font-size: 18px">Proforma Invoice</span>
                            </t>
                            <t t-else="">
                                <span style="font-size: 18px" t-if="doc.state not in ['draft','sent']">Sale Order</span>
                                <span style="font-size: 18px" t-if="doc.state in ['draft','sent']">Quotation</span>
                            </t>
                        </div>
                        <div>
                            <span style="font-size: 18px;position: absolute;">
                                <span style="font-weight: bold;">Nº:</span>
                                <span t-field="doc.name"/>
                            </span>

                            <span style="font-size: 18px;left:45mm;position: absolute;">
                                <span style="font-weight: bold;">Date:</span>
                                <span t-field="doc.date_order"
                                      t-options="{'widget': 'date', 'format':'dd/MM/yy'}"/>
                            </span>
                        </div>
                    </div>
                    <div class="col-6 text-right">
                        <img src="/dttca_custom_reports/static/src/img/logo_left.png"
                             style="height: 100px;"/>
                    </div>
                </div>
                <div class="row mt16 mb16">
                    <div class="col-6">
                        <!--<t t-if="'Extracom' in doc.partner_id.property_account_position_id.name">-->
                        <div style="color: #7F7F7F;font-size: 9px;font-weight: bold;">
                            Seller / Shipper
                        </div>
                        <div style="color: #8B857F;">
                            <div style="font-weight: bold;">
                                <span t-field="doc.company_id.partner_id.name"/>
                            </div>
                            <div>
                                <span t-field="doc.company_id.street"/>
                            </div>
                            <div>
                                <span t-field="doc.company_id.street2"/>
                            </div>
                            <div>
                                <span t-field="doc.company_id.zip"/>
                                <span t-field="doc.company_id.city"/>
                                (<t t-esc="doc.company_id.country_id.name"/>)
                            </div>
                            <div>
                                VAT:
                                <span t-field="doc.company_id.vat"/>
                            </div>
                        </div>
                        <div style="color: #8B857F;font-size: 9px;margin-top:2mm;">
                            <div>
                                <i class="fa fa-phone"/>
                                <span t-field="doc.company_id.phone"/>
                            </div>
                            <div>
                                <i class="fa fa-at"/>
                                <span t-field="doc.company_id.email"/>
                            </div>
                        </div>
                        <!--</t>-->

                        <div style="color: #7F7F7F;font-size: 9px;font-weight: bold;margin-top:2mm;">
                            Sales Person:
                        </div>
                        <div style="font-size: 10px;">
                            <div>
                                <span t-field="doc.user_id.name"/>
                            </div>
                            <div t-if="doc.user_id.mobile">
                                <i class="fa fa-phone"/>
                                <span t-field="doc.user_id.mobile"/>
                            </div>
                            <div t-if="doc.user_id.email">
                                <i class="fa fa-at"/>
                                <span t-field="doc.user_id.email"/>
                            </div>
                        </div>
                    </div>

                    <div class="col-6">
                        <div class="col-12">
                            <div style="color: #7F7F7F;font-size: 9px;font-weight: bold;">
                                Invoiced / Consignee
                            </div>
                            <div name="invoice_address">
                                <div style="font-weight: bold;">
                                    <span t-field="doc.partner_id.name"/>
                                </div>
                                <div>
                                    <span t-field="doc.partner_id.street"/>
                                </div>
                                <div>
                                    <span t-field="doc.partner_id.street2"/>
                                </div>
                                <div>
                                    <span t-field="doc.partner_id.zip"/>
                                    <span t-field="doc.partner_id.city"/>
                                    (<t t-esc="doc.partner_id.country_id.name"/>)
                                </div>
                                <div>
                                    VAT:
                                    <span t-field="doc.partner_id.vat"/>
                                </div>
                            </div>
                            <div style="font-size: 9px;margin-top:2mm;">
                                <div t-if="doc.partner_id.phone">
                                    <i class="fa fa-phone"/>
                                    <span t-field="doc.partner_id.phone"/>
                                </div>
                                <div t-if="doc.partner_id.email">
                                    <i class="fa fa-at"/>
                                    <span t-field="doc.partner_id.email"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12" style="margin-top:4mm">
                            <div style="color: #7F7F7F;font-size: 9px;font-weight: bold;">
                                Delivery / Notify
                            </div>
                            <t t-if="doc.partner_id!=doc.partner_shipping_id">
                                <div>
                                    <div style="font-weight: bold;">
                                        <span t-field="doc.partner_shipping_id.name"/>
                                    </div>
                                    <div>
                                        <span t-field="doc.partner_shipping_id.street"/>
                                    </div>
                                    <div>
                                        <span t-field="doc.partner_shipping_id.street2"/>
                                    </div>
                                    <div>
                                        <span t-field="doc.partner_shipping_id.zip"/>
                                        <span t-field="doc.partner_shipping_id.city"/>
                                        (<t t-esc="doc.partner_shipping_id.country_id.name"/>)
                                    </div>
                                </div>
                                <div style="font-size: 10px;margin-top:2mm;">
                                    <div t-if="doc.partner_shipping_id.phone">
                                        <i class="fa fa-phone"/>
                                        <span t-field="doc.partner_shipping_id.phone"/>
                                    </div>
                                    <div style="doc.partner_shipping_id.email">
                                        <i class="fa fa-at"/>
                                        <span t-field="doc.partner_shipping_id.email"/>
                                    </div>
                                </div>
                            </t>
                            <t t-else="">
                                <div>
                                    SAME AS INVOICED
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
                <div class="row" t-if="doc.client_order_ref">
                    <div class="col-12">
                        <span style="font-weight: bold;">
                            Customer Order:
                        </span>
                        <span t-field="doc.client_order_ref"/>
                    </div>
                </div>
            </div>

            <div class="page" style="font-size: 11px !important;">
                <div class="oe_structure"/>

                <!-- Is there a discount on at least one line? -->
                <t t-set="display_discount" t-value="any([l.discount for l in doc.order_line])"/>

                <table class="table table-sm o_main_table">
                    <thead style="border-bottom: 2px solid black;">
                        <tr>
                            <!-- TODO: remove in master -->
                            <t t-set="colspan" t-value="5"/>
                            <th name="th_description" class="text-left">Description</th>
                            <th name="th_quantity" class="text-right">Quantity</th>
                            <th name="th_priceunit" class="text-right">Unit Price</th>
                            <th name="th_discount" t-if="display_discount" class="text-right" groups="sale.group_discount_per_so_line">
                                <span>Disc.(%)</span>
                                <!-- TODO: remove in master -->
                                <t t-set="colspan" t-value="colspan+1"/>
                            </th>
                            <th name="th_taxes" class="text-right">Taxes</th>
                            <th name="th_subtotal" class="text-right">
                                <t groups="account.group_show_line_subtotals_tax_excluded">Amount</t>
                                <t groups="account.group_show_line_subtotals_tax_included">Total Price</t>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">

                        <t t-set="current_subtotal" t-value="0"/>

                        <t t-foreach="doc.order_line" t-as="line">

                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td name="td_name"><span t-field="line.name"/></td>
                                    <td name="td_quantity" class="text-right">
                                        <span t-field="line.product_uom_qty"/>
                                        <span t-field="line.product_uom"/>
                                    </td>
                                    <td name="td_priceunit" style="text-align:right !important;">
                                        <span t-field="line.price_unit"/>
                                    </td>
                                    <td t-if="display_discount" style="text-align:right !important;" groups="sale.group_discount_per_so_line">
                                        <span t-field="line.discount"/>
                                    </td>
                                    <td name="td_taxes" style="text-align:right !important;">
                                        <span t-esc="', '.join(map(lambda x: (x.name or x.description), line.tax_id))"/>
                                    </td>
                                    <td name="td_subtotal" class="o_price_total" style="text-align:right !important;">
                                        <span t-field="line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                                        <span t-field="line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                                    </td>
                                </t>
                                <t t-if="line.display_type == 'line_section'">
                                    <td name="td_section_line" colspan="99">
                                        <span t-field="line.name"/>
                                    </td>
                                    <t t-set="current_section" t-value="line"/>
                                    <t t-set="current_subtotal" t-value="0"/>
                                </t>
                                <t t-if="line.display_type == 'line_note'">
                                    <td name="td_note_line" colspan="99">
                                        <span t-field="line.name"/>
                                    </td>
                                </t>
                            </tr>

                            <t t-if="current_section and (line_last or doc.order_line[line_index+1].display_type == 'line_section')">
                                <tr class="is-subtotal text-right">
                                    <td name="td_section_subtotal" colspan="99">
                                        <strong class="mr16">Subtotal</strong>
                                        <span
                                            t-esc="current_subtotal"
                                            t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'
                                        />
                                    </td>
                                </tr>
                            </t>
                        </t>
                    </tbody>
                </table>

                <div class="clearfix">
                    <div id="total" class="row mt16 mb16" name="total">
                        <div class="col-7">
                            <div t-if="doc.payment_term_id">
                                <strong>Payment Term:</strong>
                                <span t-field="doc.payment_term_id.name"/>
                            </div>
                            <div t-if="doc.payment_mode_id">
                                <strong>Payment Mode:</strong>
                                <span t-field="doc.payment_mode_id.name"/>
                            </div>
                            <div style="margin-top:5px" t-if="doc.payment_mode_id">
                                <t t-if="doc.payment_mode_id and doc.payment_mode_id.show_bank_account != 'no'">
                                    <p t-foreach="doc.partner_banks_to_show()" t-as="partner_bank">
                                        <div t-if="partner_bank.bank_id">
                                            <span t-field="partner_bank.bank_id"/>
                                        </div>
                                        <div>
                                            <strong>IBAN:</strong>
                                            <t t-if="doc.payment_mode_id.show_bank_account == 'full'">
                                                <span t-field="partner_bank.acc_number"/>
                                            </t>
                                            <t t-elif="doc.payment_mode_id.show_bank_account == 'first'">
                                                <span t-esc="partner_bank.acc_number[:doc.payment_mode_id.show_bank_account_chars] + '*' * (len(partner_bank.acc_number) - doc.payment_mode_id.show_bank_account_chars)"/>
                                            </t>
                                            <t t-elif="doc.payment_mode_id.show_bank_account == 'last'">
                                                <span t-esc="'*' * (len(partner_bank.acc_number) - doc.payment_mode_id.show_bank_account_chars) + partner_bank.acc_number[-doc.payment_mode_id.show_bank_account_chars:]"/>
                                            </t>
                                        </div>
                                        <div t-if="partner_bank.bank_id.bic">
                                            <strong>SWIFT CODE:</strong>
                                            <span t-field="partner_bank.bank_id.bic"/>
                                        </div>
                                    </p>
                                </t>
                            </div>
                            <t t-if="doc.fiscal_position_id and 'com' in doc.fiscal_position_id.name">
                                <div style="margin-top:5px" t-if="doc.incoterm">
                                    <strong>Incoterm:</strong>
                                    <span t-field="doc.incoterm.code"/>
                                </div>
                            </t>
                        </div>
                        <div class="col-5 pull-right">
                            <div id="total" class="row" name="total">
                                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                    <table class="table table-sm table-borderless">
                                        <!-- Tax totals -->
                                        <t t-set="tax_totals" t-value="doc.tax_totals"/>
                                        <t t-call="account.document_tax_totals"/>
                                    </table>
                                </div>
                            </div>
                            <!-- COMENTADO EN MIGRACION
                            <table class="table table-sm">
                                <tr class="border-black o_subtotal" style="">
                                    <td name="td_amount_untaxed_label"><strong>Subtotal</strong></td>
                                    <td name="td_amount_untaxed" class="text-right">
                                        <span t-field="doc.amount_untaxed"/>
                                    </td>
                                </tr>
                                <t t-foreach="doc.amount_by_group" t-as="amount_by_group">
                                    <tr style="">
                                        <t t-if="amount_by_group[5] == 1 and doc.amount_untaxed == amount_by_group[2]">
                                            <td name="td_amount_by_group_label_3">
                                                <span t-esc="amount_by_group[0]"/>
                                                <span>&amp;nbsp;<span>on</span>&amp;nbsp;<t t-esc="amount_by_group[2]" t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/></span>
                                            </td>
                                            <td name="td_amount_by_group_3" class="text-right o_price_total">
                                                <span t-esc="amount_by_group[1]"
                                                    t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                            </td>
                                        </t>
                                        <t t-else="">
                                            <td name="td_amount_by_group_label">
                                                <span t-esc="amount_by_group[0]"/>
                                            </td>
                                            <td name="td_amount_by_group" class="text-right o_price_total">
                                                <span t-esc="amount_by_group[1]"
                                                    t-options='{"widget": "monetary", "display_currency": doc.pricelist_id.currency_id}'/>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                                <tr class="border-black o_total">
                                    <td name="td_amount_total_label"><strong>Total</strong></td>
                                    <td name="td_amount_total" class="text-right">
                                        <span t-field="doc.amount_total"/>
                                    </td>
                                </tr>
                            </table>
                            --> 
                        </div>
                    </div>
                </div>

                <p t-if="doc.note" styte="margin-top:15px;">
                    <span t-field="doc.note"/>
                </p>

                <div class="oe_structure"/>
            </div>
        </t>
    </template>


    <template id="sale.report_saleorder">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="dttca_custom_reports.report_saleorder_document_alq" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <template id="sale.report_saleorder_pro_forma">
        <t t-call="web.html_container">
            <t t-set="is_pro_forma" t-value="True"/>
            <t t-set="docs" t-value="docs.with_context(proforma=True)"/>
            <t t-foreach="docs" t-as="doc">
                <t t-call="dttca_custom_reports.report_saleorder_document_alq" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>
</odoo>
